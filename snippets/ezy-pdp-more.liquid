{%- comment -%}
  Long wiper product page (the extra blocks Matt asked for). Rendered by ezy-product before the FAQ,
  so it only shows on wiper pages. Reuses the homepage block styles; nothing here repeats the
  fit panel, add-ons, video or reviews above it.
  Data blocks stay hidden until the product has the data:
    custom.clip_photo (file) shows the "Your clip" block,
    custom.customer_count (number) adds the customer count to the photo heading.
{%- endcomment -%}
{%- liquid
  assign clip_photo = product.metafields.custom.clip_photo.value
  assign customers = product.metafields.custom.customer_count.value
  assign photos = 'cb-real-1.jpg,cb-real-3.jpg,cb-real-4.jpg,cb-real-5.jpg,cb-real-7.jpg,cb-real-8.jpg' | split: ','
  assign shade_img = images['SideShade2.png']
-%}
<div data-ezy-pdp-more>
  {%- if clip_photo != blank -%}
    <section class="ezy ezy-sec ezy-sec--rule" id="ezy-pdp-clip" data-ezy-pdp-clip>
      <div class="ezy-wrap ezy-shades__grid">
        {{ clip_photo | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'Wiper arm clip on the ' | append: car_name }}
        <div>
          <h2 class="ezy-h2">Your clip</h2>
          <p class="ezy-sub">This is the clip on your {{ car_name }}. Our blades come with the matching connector.</p>
        </div>
      </div>
    </section>
  {%- endif -%}

  <section class="ezy ezy-sec ezy-sec--rule" id="ezy-pdp-photos">
    <div class="ezy-wrap">
      <h2 class="ezy-h2">{% if customers != blank %}Fitted by {{ customers }}+ drivers{% else %}Fitted by drivers like you{% endif %}</h2>
      <p class="ezy-sub">Real photos sent in by customers.</p>
      <div class="ezy-photos">
        {%- for f in photos -%}
          <div class="ezy-photo">{% render 'ezy-customer-photo', file: f, alt: "Blades fitted on a customer's car" %}</div>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="ezy ezy-sec ezy-sec--yellow ezy-sec--rule" id="ezy-pdp-compare">
    <div class="ezy-wrap">
      <h2 class="ezy-h2">Your Click Shades blades</h2>
      <p class="ezy-sub" style="color: var(--ezy-dark)">Check the fit and product details above before ordering.</p>
      <table class="ezy-compare">
        <thead><tr><th scope="col">Product detail</th><th scope="col" class="is-us">Click Shades</th></tr></thead>
        <tbody>
          <tr><th scope="row">Vehicle-specific connector</th><td class="is-us">Included</td></tr>
          {%- if product.metafields.custom.fit_video.value != blank or section.settings.fit_video != blank -%}
            <tr><th scope="row">Fitting video</th><td class="is-us"><a href="#ezy-pdp-video">Watch the fitting guide</a></td></tr>
          {%- endif -%}
        </tbody>
      </table>
    </div>
  </section>

  <section class="ezy ezy-sec ezy-sec--yellow ezy-sec--rule" id="ezy-pdp-guarantee" style="border-bottom: 3px solid var(--ezy-blue)">
    <div class="ezy-wrap">
      <div class="ezy-guarantee">
        <h2>Fits your car, or return it within 30 days</h2>
        <p>These blades are made for your {{ car_name }}. If they don't fit, start a return within 30 days for a refund: you pay the actual cost of return shipping unless the error was ours.</p>
        <a class="ezy-btn" href="#ezy-pdp-top">Add to cart</a>
      </div>
    </div>
  </section>

  <section class="ezy ezy-sec ezy-sec--blue ezy-shades" id="ezy-pdp-shades">
    <div class="ezy-wrap ezy-shades__grid">
      {%- if shade_img != blank -%}
        {{ shade_img | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'Click Shades fitted to a car side window' }}
      {%- else -%}
        <img src="{{ 'ezy-shade-ranger.png' | asset_url }}" alt="Click Shades fitted to a car side window" loading="lazy" width="900" height="675">
      {%- endif -%}
      <div>
        <h2>Keep the sun out too</h2>
        <p>Click-in car shades made for the same cars as our wipers, with a magnetic fit instead of suction cups.</p>
        <a class="ezy-btn ezy-btn--yellow" href="/collections/car-window-shades">Shop car shades</a>
      </div>
    </div>
  </section>
</div>
