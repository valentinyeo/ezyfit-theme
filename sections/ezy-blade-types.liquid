{{ 'ezy.css' | asset_url | stylesheet_tag }}
<section class="ezy ezy-sec ezy-sec--rule">
  <div class="ezy-wrap">
    <h2 class="ezy-h2">{{ section.settings.heading }}</h2>
    <p class="ezy-sub">{{ section.settings.sub }}</p>
    <div class="ezy-types">
      {%- for block in section.blocks -%}
        {%- assign best = block.settings.badge | strip -%}
        <div class="ezy-card ezy-type{% if best != blank %} ezy-type--best{% endif %}" {{ block.shopify_attributes }}>
          {%- if best != blank -%}<span class="ezy-type__badge">{{ best }}</span>{%- endif -%}
          <div class="ezy-type__top">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: block.settings.name }}
            {%- elsif block.settings.fallback_asset != blank -%}
              <img src="{{ block.settings.fallback_asset | asset_url }}" alt="{{ block.settings.name }}" loading="lazy">
            {%- endif -%}
            <div>
              <h3>{{ block.settings.name }}</h3>
              <p class="ezy-type__for">{{ block.settings.for }}</p>
              <div class="ezy-type__level" aria-hidden="true">
                {%- for i in (1..3) -%}<i{% if i <= block.settings.level %} class="on"{% endif %}></i>{%- endfor -%}
              </div>
            </div>
          </div>
          <p class="ezy-type__desc">{{ block.settings.desc }}</p>
          <div class="ezy-type__price"><b>{{ block.settings.price }}</b>{% if block.settings.was != blank %}<s>{{ block.settings.was }}</s>{% endif %}</div>
          <p class="ezy-type__pay">{{ block.settings.pay }}</p>
          {%- if block.settings.rear != blank -%}<div class="ezy-type__rear">{{ block.settings.rear }}</div>{%- endif -%}
          <hr>
          <ul class="ezy-ticks ezy-ticks--green">
            {%- assign lines = block.settings.ticks | newline_to_br | split: '<br />' -%}
            {%- for line in lines -%}
              {%- assign l = line | strip -%}
              {%- if l == blank -%}{%- continue -%}{%- endif -%}
              {%- if l contains 'no:' -%}<li class="is-no">{{ l | remove_first: 'no:' | strip }}</li>{%- else -%}<li>{{ l }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
          <a class="ezy-btn{% if best == blank %} ezy-btn--ghost{% endif %}" href="{{ block.settings.link | default: '#find' }}">
            {{ block.settings.button }}<small>{{ section.settings.next_text }}</small>
          </a>
        </div>
      {%- endfor -%}
      {%- if section.settings.unsure != blank -%}
        <div class="ezy-types__unsure"><div>{{ section.settings.unsure }}</div></div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "EZY Standard or Spray",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Standard or Spray?" },
    { "type": "text", "id": "sub", "label": "Subheading", "default": "Both fit your car exactly. Pick by how you drive." },
    { "type": "text", "id": "next_text", "label": "Small text on buttons", "default": "Next: pick your car" },
    { "type": "richtext", "id": "unsure", "label": "Not sure text", "default": "<p><strong>Not sure?</strong> Standard suits most drivers. Spray suits dust, bugs and long trips. Swap free within 30 days if it is not right.</p>" }
  ],
  "blocks": [
    {
      "type": "type",
      "name": "Blade type",
      "settings": [
        { "type": "text", "id": "badge", "label": "Badge (makes it the highlighted card)" },
        { "type": "text", "id": "name", "label": "Name", "default": "Standard" },
        { "type": "text", "id": "for", "label": "Best for", "default": "For everyday driving" },
        { "type": "range", "id": "level", "label": "Level bars", "min": 1, "max": 3, "step": 1, "default": 2 },
        { "type": "textarea", "id": "desc", "label": "Description" },
        { "type": "text", "id": "price", "label": "Price", "default": "$69" },
        { "type": "text", "id": "was", "label": "Was price", "default": "$89" },
        { "type": "text", "id": "pay", "label": "Payment line" },
        { "type": "text", "id": "rear", "label": "Rear blade add-on line" },
        { "type": "textarea", "id": "ticks", "label": "Ticks, one per line. Start a line with no: for a cross." },
        { "type": "text", "id": "button", "label": "Button", "default": "Choose Standard" },
        { "type": "url", "id": "link", "label": "Button link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_asset", "label": "Placeholder image file (theme assets)" }
      ]
    }
  ]
}
{% endschema %}
