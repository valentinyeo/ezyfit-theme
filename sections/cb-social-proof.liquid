<style>
  .cb-proof-section {
    padding: 40px 16px;
    background: var(--dark, #1a1a1a);
  }

  .cb-proof-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    max-width: 800px;
    margin: 0 auto;
  }

  .cb-proof-stat {
    text-align: center;
  }

  .cb-proof-number {
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 32px;
    font-weight: 700;
    color: var(--yellow, #ffd600);
    margin: 0;
    line-height: 1.2;
  }

  .cb-proof-label {
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.7);
    margin: 6px 0 0;
    line-height: 1.3;
  }

  .cb-proof-divider {
    display: none;
  }

  @media (min-width: 768px) {
    .cb-proof-section {
      padding: 56px 40px;
    }

    .cb-proof-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      position: relative;
    }

    .cb-proof-stat {
      padding: 0 24px;
      position: relative;
    }

    .cb-proof-stat:not(:last-child)::after {
      content: '';
      position: absolute;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
      width: 1px;
      height: 48px;
      background: rgba(255, 255, 255, 0.15);
    }

    .cb-proof-number {
      font-size: 42px;
    }

    .cb-proof-label {
      font-size: 14px;
      margin-top: 8px;
    }
  }
</style>

<section class="cb-proof-section">
  <div class="cb-proof-grid">
    <div class="cb-proof-stat">
      <p class="cb-proof-number">{{ section.settings.stat_1_number | default: '10,000+' }}</p>
      <p class="cb-proof-label">{{ section.settings.stat_1_label | default: 'Happy Customers' }}</p>
    </div>
    <div class="cb-proof-stat">
      <p class="cb-proof-number">{{ section.settings.stat_2_number | default: '4.9' }}</p>
      <p class="cb-proof-label">{{ section.settings.stat_2_label | default: 'Star Rating' }}</p>
    </div>
    <div class="cb-proof-stat">
      <p class="cb-proof-number">{{ section.settings.stat_3_number | default: '2 min' }}</p>
      <p class="cb-proof-label">{{ section.settings.stat_3_label | default: 'Easy Install' }}</p>
    </div>
    <div class="cb-proof-stat">
      <p class="cb-proof-number">{{ section.settings.stat_4_number | default: '100%' }}</p>
      <p class="cb-proof-label">{{ section.settings.stat_4_label | default: 'Australian Owned' }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CB Social Proof",
  "settings": [
    {
      "type": "header",
      "content": "Stat 1"
    },
    {
      "type": "text",
      "id": "stat_1_number",
      "label": "Number",
      "default": "10,000+"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Label",
      "default": "Happy Customers"
    },
    {
      "type": "header",
      "content": "Stat 2"
    },
    {
      "type": "text",
      "id": "stat_2_number",
      "label": "Number",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Label",
      "default": "Star Rating"
    },
    {
      "type": "header",
      "content": "Stat 3"
    },
    {
      "type": "text",
      "id": "stat_3_number",
      "label": "Number",
      "default": "2 min"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Label",
      "default": "Easy Install"
    },
    {
      "type": "header",
      "content": "Stat 4"
    },
    {
      "type": "text",
      "id": "stat_4_number",
      "label": "Number",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "stat_4_label",
      "label": "Label",
      "default": "Australian Owned"
    }
  ],
  "presets": [
    {
      "name": "CB Social Proof"
    }
  ]
}
{% endschema %}
