<!-- Hero Video Lightbox (Cinema Mode) -->
<div class="cb-hero-video-lightbox" id="cbHeroVideoLightbox">
  <div class="cb-hero-lightbox-backdrop" id="cbHeroLightboxBackdrop"></div>
  <div class="cb-hero-lightbox-content">
    <video id="cbHeroLightboxVideo" controls playsinline>
      <source src="https://cdn.shopify.com/videos/c/o/v/10d501d9fdd8462e94e96d31a8416eec.mp4" type="video/mp4">
    </video>
    <button class="cb-hero-lightbox-close" id="cbHeroLightboxCloseBtn" aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const cbVideoLink = document.getElementById('cbHeroVideoLink');
  const cbLightbox = document.getElementById('cbHeroVideoLightbox');
  const cbLightboxVideo = document.getElementById('cbHeroLightboxVideo');
  const cbLightboxClose = cbLightbox?.querySelector('.cb-hero-lightbox-close');
  const cbLightboxBackdrop = cbLightbox?.querySelector('.cb-hero-lightbox-backdrop');

  function openCbLightbox(e) {
    e.preventDefault();
    if (cbLightbox && cbLightboxVideo) {
      cbLightbox.classList.add('active');
      cbLightboxVideo.play();
      document.body.style.overflow = 'hidden';
    }
  }

  function closeCbLightbox() {
    if (cbLightbox && cbLightboxVideo) {
      cbLightbox.classList.remove('active');
      cbLightboxVideo.pause();
      cbLightboxVideo.currentTime = 0;
      document.body.style.overflow = '';
    }
  }

  if (cbVideoLink) cbVideoLink.addEventListener('click', openCbLightbox);
  if (cbLightboxClose) cbLightboxClose.addEventListener('click', closeCbLightbox);
  if (cbLightboxBackdrop) cbLightboxBackdrop.addEventListener('click', closeCbLightbox);

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && cbLightbox?.classList.contains('active')) {
      closeCbLightbox();
    }
  });
});
</script>

