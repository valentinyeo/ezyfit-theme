<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Get menu elements
    const menuButton = document.querySelector('.header-menu-toggle');
    const mobileMenu = document.getElementById('mobileMenu');
    const closeButton = document.querySelector('.mobile-menu-close');
    const overlay = document.querySelector('.mobile-menu-overlay');
    const menuLinks = document.querySelectorAll('.mobile-menu-link');

    // Open menu
    function openMenu() {
      mobileMenu.classList.add('open');
      document.body.classList.add('menu-open');
      menuButton.setAttribute('aria-expanded', 'true');
    }

    // Close menu
    function closeMenu() {
      mobileMenu.classList.remove('open');
      document.body.classList.remove('menu-open');
      menuButton.setAttribute('aria-expanded', 'false');
    }

    // Menu button click
    menuButton.addEventListener('click', function (e) {
      e.preventDefault();
      if (mobileMenu.classList.contains('open')) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Close button click
    closeButton.addEventListener('click', closeMenu);

    // Overlay click
    overlay.addEventListener('click', closeMenu);

    // Menu link clicks
    menuLinks.forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    // Escape key
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && mobileMenu.classList.contains('open')) {
        closeMenu();
      }
    });

    // Close menu when window resizes above mobile breakpoint
    window.addEventListener('resize', function () {
      if (window.innerWidth >= 768 && mobileMenu.classList.contains('open')) {
        closeMenu();
      }
    });

    // ========== SEARCH FUNCTIONALITY ==========
    const searchButton = document.querySelector('.header-search');
    const searchOverlay = document.getElementById('searchOverlay');
    const searchClose = document.querySelector('.search-close');
    const searchBackdrop = document.querySelector('.search-overlay-backdrop');
    const searchInput = document.getElementById('searchInput');
    const searchContent = document.querySelector('.search-overlay-content');

    // Move search overlay to body to ensure proper fixed positioning
    // This bypasses any parent container CSS constraints
    if (searchOverlay && searchOverlay.parentNode !== document.body) {
      document.body.appendChild(searchOverlay);
    }

    // Open search - apply inline styles to ensure overlay works
    function openSearch() {
      // Add class for CSS
      searchOverlay.classList.add('active');

      // Force inline styles for desktop modal (bypasses any CSS conflicts)
      if (window.innerWidth >= 768) {
        searchOverlay.style.cssText = 'display: block; position: fixed; top: 0; left: 0; right: 0; bottom: 0; width: 100vw; height: 100vh; z-index: 999999; background: rgba(0, 0, 0, 0.6);';
        if (searchContent) {
          searchContent.style.cssText = 'position: absolute; top: 100px; left: 50%; transform: translateX(-50%); width: 90%; max-width: 640px; background: #ffffff; border-radius: 16px; box-shadow: 0 16px 48px rgba(0, 0, 0, 0.25); z-index: 2; max-height: calc(100vh - 140px); overflow: hidden; display: flex; flex-direction: column;';
        }
      }

      document.body.style.overflow = 'hidden';
      // Focus input after animation
      setTimeout(() => {
        searchInput.focus();
      }, 100);
    }

    // Close search
    function closeSearch() {
      searchOverlay.classList.remove('active');
      // Clear inline styles
      searchOverlay.style.cssText = '';
      if (searchContent) {
        searchContent.style.cssText = '';
      }
      document.body.style.overflow = '';
      searchInput.value = '';
    }

    // Search button click
    if (searchButton) {
      searchButton.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        openSearch();
      });
    }

    // Close button click
    if (searchClose) {
      searchClose.addEventListener('click', closeSearch);
    }

    // Backdrop click (dark overlay behind modal)
    if (searchBackdrop) {
      searchBackdrop.addEventListener('click', closeSearch);
    }

    // Click on overlay background (outside the modal content) also closes
    if (searchOverlay) {
      searchOverlay.addEventListener('click', function(e) {
        // Only close if clicking directly on the overlay, not on children
        if (e.target === searchOverlay) {
          closeSearch();
        }
      });
    }

    // Escape key to close search
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && searchOverlay.classList.contains('active')) {
        closeSearch();
      }
    });

    // ========== PREDICTIVE SEARCH FUNCTIONALITY ==========
    const searchResults = document.getElementById('searchResults');
    const searchLoading = document.getElementById('searchLoading');
    const searchEmpty = document.getElementById('searchEmpty');
    const searchSuggestions = document.getElementById('searchSuggestions');
    const searchSectionTitle = document.getElementById('searchSectionTitle');
    const searchProducts = document.getElementById('searchProducts');
    const searchViewAll = document.getElementById('searchViewAll');

    let debounceTimer;
    let currentQuery = '';
    let selectedIndex = -1;
    let productItems = [];

    // Common car makes and search suggestions
    const carMakes = ['Toyota', 'Ford', 'Mazda', 'BMW', 'Nissan', 'Hyundai', 'Mitsubishi', 'Honda', 'Subaru', 'Volkswagen', 'Kia', 'Mercedes', 'Lexus', 'Isuzu'];
    const categories = [
      { name: 'Windscreen Shades', url: '/collections/car-window-shades', keywords: ['shade', 'sun', 'window', 'windscreen', 'front'] },
      { name: 'Side Window Shades', url: '/collections/car-window-shades', keywords: ['side', 'rear', 'back', 'window'] },
      { name: 'Wiper Blades', url: '/pages/click-blades', keywords: ['wiper', 'blade', 'rain', 'windscreen'] }
    ];

    // Debounced search function
    function debounceSearch(query) {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        performSearch(query);
      }, 300);
    }

    // Perform the actual search
    async function performSearch(query) {
      if (!query || query.length < 2) {
        hideResults();
        return;
      }

      currentQuery = query;
      showLoading();

      try {
        const response = await fetch(`/search/suggest.json?q=${encodeURIComponent(query)}&resources[type]=product&resources[limit]=6`);
        const data = await response.json();

        if (data.resources && data.resources.results && data.resources.results.products) {
          displayResults(data.resources.results.products);
        } else {
          showEmpty();
        }
      } catch (error) {
        console.error('Search error:', error);
        showEmpty();
      }
    }

    // Generate suggestions based on query
    function generateSuggestions(query) {
      const lowerQuery = query.toLowerCase();

      // Add matching car makes
      const matchingMakes = carMakes.filter(make =>
        make.toLowerCase().includes(lowerQuery)
      ).slice(0, 3); // Limit to 3 makes

      // Add matching categories based on keywords
      const matchingCategories = categories.filter(cat =>
        cat.name.toLowerCase().includes(lowerQuery) ||
        cat.keywords.some(kw => kw.includes(lowerQuery) || lowerQuery.includes(kw))
      );

      return { makes: matchingMakes, categories: matchingCategories };
    }

    // Display suggestions (Decathlon style)
    function displaySuggestions(query) {
      const { makes, categories: matchingCategories } = generateSuggestions(query);

      let suggestionsHTML = '<div class="search-suggestions-section">';
      suggestionsHTML += '<h3 class="search-suggestions-title">Suggested</h3>';

      // Add car make suggestions with highlighted query - now as clickable links
      makes.forEach(make => {
        const highlighted = make.replace(new RegExp(`(${query})`, 'gi'), '<strong>$1</strong>');
        suggestionsHTML += `
          <a href="/search?q=${encodeURIComponent(make)}" class="search-suggestion-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span class="search-suggestion-text">${highlighted}</span>
          </a>
        `;
      });

      // Add category suggestions
      matchingCategories.forEach(cat => {
        suggestionsHTML += `
          <a href="${cat.url}?q=${encodeURIComponent(query)}" class="search-suggestion-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect>
            </svg>
            <span class="search-suggestion-text">${cat.name}</span>
          </a>
        `;
      });

      // Always add "All results for X" link at the end
      suggestionsHTML += `
        <a href="/search?q=${encodeURIComponent(query)}" class="search-suggestion-item search-all-results">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span class="search-suggestion-text">All results for '<strong>${query}</strong>'</span>
        </a>
      `;

      suggestionsHTML += '</div>';
      searchSuggestions.innerHTML = suggestionsHTML;
      searchSuggestions.classList.add('visible');

      // Suggestions are now <a> links, no need for click handlers
    }

    // Show loading state
    function showLoading() {
      searchResults.classList.add('visible');
      searchLoading.classList.add('visible');
      searchEmpty.classList.remove('visible');
      searchSuggestions.classList.remove('visible');
      searchSectionTitle.classList.remove('visible');
      searchProducts.innerHTML = '';
      searchViewAll.classList.remove('visible');
    }

    // Hide all results
    function hideResults() {
      searchResults.classList.remove('visible');
      searchLoading.classList.remove('visible');
      searchEmpty.classList.remove('visible');
      searchSuggestions.classList.remove('visible');
      searchSectionTitle.classList.remove('visible');
      searchProducts.innerHTML = '';
      searchViewAll.classList.remove('visible');
      selectedIndex = -1;
      productItems = [];
    }

    // Show empty state
    function showEmpty() {
      searchLoading.classList.remove('visible');
      searchEmpty.classList.add('visible');
      searchSuggestions.classList.remove('visible');
      searchSectionTitle.classList.remove('visible');
      searchProducts.innerHTML = '';
      searchViewAll.classList.remove('visible');
    }

    // Display search results
    function displayResults(products) {
      searchLoading.classList.remove('visible');
      searchEmpty.classList.remove('visible');

      if (!products || products.length === 0) {
        showEmpty();
        return;
      }

      // Show suggestions first
      displaySuggestions(currentQuery);

      // Show "PRODUCTS" section title if there are suggestions
      if (searchSuggestions.classList.contains('visible')) {
        searchSectionTitle.classList.add('visible');
      }

      // Build product items HTML
      const productsHTML = products.map((product, index) => {
        const price = product.price ? `$${parseFloat(product.price).toFixed(2)}` : '';

        // Get image from Shopify API response
        let image = 'https://clickshades.com.au/cdn/shop/files/FrontWindscreenShade_1200x1200.png?v=1706155339';
        if (product.featured_image) {
          image = product.featured_image.url || product.featured_image;
        } else if (product.image) {
          image = product.image;
        }
        // Handle protocol-relative URLs
        if (image && image.startsWith('//')) {
          image = 'https:' + image;
        }

        return `
          <a href="${product.url}" class="search-product-item" data-index="${index}">
            <div class="search-product-image">
              <img src="${image}" alt="${product.title}" loading="lazy">
            </div>
            <div class="search-product-info">
              <h3 class="search-product-title">${product.title}</h3>
              ${price ? `<div class="search-product-price">${price}</div>` : ''}
            </div>
          </a>
        `;
      }).join('');

      searchProducts.innerHTML = productsHTML;

      // Update view all link
      searchViewAll.href = `/search?q=${encodeURIComponent(currentQuery)}`;
      searchViewAll.classList.add('visible');

      // Get all product items for keyboard navigation
      productItems = searchProducts.querySelectorAll('.search-product-item');
      selectedIndex = -1;
    }

    // Keyboard navigation
    function handleKeyboardNav(e) {
      if (!searchResults.classList.contains('visible') || productItems.length === 0) {
        return;
      }

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = (selectedIndex + 1) % productItems.length;
        updateSelection();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = selectedIndex <= 0 ? productItems.length - 1 : selectedIndex - 1;
        updateSelection();
      } else if (e.key === 'Enter' && selectedIndex >= 0) {
        e.preventDefault();
        productItems[selectedIndex].click();
      }
    }

    // Update visual selection
    function updateSelection() {
      productItems.forEach((item, index) => {
        if (index === selectedIndex) {
          item.classList.add('active');
          item.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        } else {
          item.classList.remove('active');
        }
      });
    }

    // Listen to input changes
    if (searchInput) {
      searchInput.addEventListener('input', function (e) {
        debounceSearch(e.target.value.trim());
      });

      searchInput.addEventListener('keydown', handleKeyboardNav);
    }

    // Close results when clicking outside
    document.addEventListener('click', function (e) {
      if (!searchResults.contains(e.target) && e.target !== searchInput) {
        hideResults();
      }
    });

    // Clear results when closing search overlay
    const originalCloseSearch = closeSearch;
    closeSearch = function() {
      originalCloseSearch();
      hideResults();
    };

    // ========== CALL PANEL FUNCTIONALITY ==========
    const floatingCallBtn = document.getElementById('floatingCallBtn');
    const callPanel = document.getElementById('callPanel');
    const callPanelClose = document.querySelector('.call-panel-close');
    const callPanelOverlay = document.querySelector('.call-panel-overlay');

    // Open call panel
    function openCallPanel() {
      callPanel.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    // Close call panel
    function closeCallPanel() {
      callPanel.classList.remove('open');
      document.body.style.overflow = '';
    }

    // Button click to open panel
    if (floatingCallBtn) {
      floatingCallBtn.addEventListener('click', openCallPanel);
    }

    // Close button click
    if (callPanelClose) {
      callPanelClose.addEventListener('click', closeCallPanel);
    }

    // Overlay click to close
    if (callPanelOverlay) {
      callPanelOverlay.addEventListener('click', closeCallPanel);
    }

    // ESC key to close
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && callPanel.classList.contains('open')) {
        closeCallPanel();
      }
    });

    // Handle phone links that should open call panel (with class .js-open-call-panel)
    // Only intercept on mobile/tablet (< 1024px) where call panel is visible
    document.querySelectorAll('.js-open-call-panel').forEach(function(link) {
      link.addEventListener('click', function(e) {
        if (window.innerWidth < 1024) {
          e.preventDefault();
          openCallPanel();
        }
        // On desktop (>= 1024px), allow normal tel: link behavior
      });
    });

    // Make openCallPanel available globally for other scripts
    window.openCallPanel = openCallPanel;
  });
</script>

