    margin-bottom: 20px;
  }

  .call-panel-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .call-panel-icon svg {
    width: 24px;
    height: 24px;
    color: #2463af;
  }

  .call-panel-info {
    flex: 1;
  }

  .call-panel-label {
    font-size: 15px;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 12px;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .call-panel-cta-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #1a1a1a;
    color: #ffffff;
    text-decoration: none;
    padding: 12px 24px;
