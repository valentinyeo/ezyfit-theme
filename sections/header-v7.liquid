    font-size: 14px;
    padding: 6px 0;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .call-panel-link:hover {
    text-decoration: underline;
  }

  /* Hide on tablet and desktop */
  @media (min-width: 1024px) {
    .floating-call-button,
    .call-panel {
      display: none;
    }
  }
