  /* ========== FULL-PAGE MOBILE MENU ========== */
  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9998;
    display: flex;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .mobile-menu.open {
    pointer-events: auto;
    opacity: 1;
  }

  /* Overlay Background */
  .mobile-menu-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    cursor: pointer;
  }

  /* Menu Content Container - Full Screen */
  .mobile-menu-content {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 9999;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .mobile-menu.open .mobile-menu-content {
    transform: translateX(0);
  }

  /* Menu Header */
  .mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px;
    border-bottom: 1px solid #e5e5e5;
    flex-shrink: 0;
  }

  .mobile-menu-title {
    font-size: 20px;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .mobile-menu-close {
    background: none;
    border: none;
    padding: 8px;
    cursor: pointer;
    color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mobile-menu-close svg {
    width: 24px;
    height: 24px;
  }

  .mobile-menu-close:hover {
    background: #f5f5f5;
    border-radius: 4px;
  }

  /* Navigation */
  .mobile-menu-nav {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .mobile-menu-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-menu-link {
    display: block;
    padding: 16px 20px;
    color: #1a1a1a;
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    border-bottom: 1px solid #f5f5f5;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .mobile-menu-link:hover {
    background-color: #f5f5f5;
    color: #1e52d4;
  }

  .mobile-menu-link:active {
    background-color: #eeeeee;
  }

  /* Bottom Section */
  .mobile-menu-bottom {
    flex-shrink: 0;
    border-top: 1px solid #e5e5e5;
    padding: 20px;
    background: #f9f9f9;
  }

  /* Social Links */
  .mobile-menu-social {
    display: flex;
    gap: 16px;
    justify-content: center;
  }

  .mobile-menu-social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: #ffffff;
    border-radius: 50%;
    color: #1a1a1a;
    transition: background-color 0.2s ease, color 0.2s ease;
    border: 1px solid #e5e5e5;
  }

  .mobile-menu-social-link:hover {
    background: #1e52d4;
    color: #ffffff;
    border-color: #1e52d4;
  }

  .mobile-menu-social-link svg {
    width: 20px;
    height: 20px;
  }

  /* Prevent body scroll when menu is open */
  body.menu-open {
    overflow: hidden;
  }

  /* Hide menu on desktop */
  @media (min-width: 768px) {
    .header-menu-toggle {
      display: none !important;
    }

    .mobile-menu {
      display: none;
    }
  }

  /* ========== FLOATING CALL BUTTON (Mobile Only) ========== */
  .floating-call-button {
    position: fixed;
    bottom: 20px;
    right: 16px;
    z-index: 9997;
    display: flex;
    align-items: center;
    gap: 8px;
    background: #2463af;
    color: #ffffff;
    border: none;
    padding: 12px 20px;
    border-radius: 30px;
    box-shadow: 0 4px 12px rgba(36, 99, 175, 0.4);
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 15px;
    font-weight: 600;
    transition: all 0.2s ease;
    animation: subtle-pulse 2s ease-in-out infinite;
    cursor: pointer;
  }

  .floating-call-button svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .floating-call-button:hover,
  .floating-call-button:active {
    background: #1e52d4;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(36, 99, 175, 0.5);
  }

  @keyframes subtle-pulse {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
  }

  /* ========== CALL PANEL (Slide-in) ========== */
  .call-panel {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .call-panel.open {
    opacity: 1;
