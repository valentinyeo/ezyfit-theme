{{ 'ezy.css' | asset_url | stylesheet_tag }}
{{ 'ezy-parts.css' | asset_url | stylesheet_tag }}
<section class="ezy ezy-sec ezy-parts" id="ezy-shop-by-part">
  <div class="ezy-wrap">
    <h2 class="ezy-h2">{{ section.settings.heading }}</h2>
    {%- if section.settings.sub != blank -%}<p class="ezy-sub">{{ section.settings.sub }}</p>{%- endif -%}
    <ul class="ezy-parts__grid">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <a class="ezy-parts__tile" href="{{ block.settings.link | default: '#' }}">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: block.settings.alt, class: 'ezy-parts__img' }}
            {%- elsif block.settings.fallback_asset != blank -%}
              <img class="ezy-parts__img" src="{{ block.settings.fallback_asset | asset_url }}" alt="{{ block.settings.alt | escape }}" loading="lazy" width="700" height="525">
            {%- endif -%}
            <span class="ezy-parts__body">
              <span class="ezy-parts__title">{{ block.settings.title }}</span>
              <span class="ezy-parts__text">{{ block.settings.text }}</span>
              {%- if block.settings.price != blank -%}<span class="ezy-parts__price">{{ block.settings.price }}</span>{%- endif -%}
              <span class="ezy-parts__go">{{ block.settings.button }}</span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "EZY shop by part",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by part" },
    { "type": "text", "id": "sub", "label": "Subtext", "default": "Pick the part, then pick your car." }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Part tile",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Wipers" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "text", "id": "price", "label": "Price line" },
        { "type": "text", "id": "button", "label": "Button text", "default": "Shop wipers" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_asset", "label": "Image file (theme assets), used when no image is picked" },
        { "type": "text", "id": "alt", "label": "Image description" }
      ]
    }
  ],
  "presets": [{ "name": "EZY shop by part" }]
}
{% endschema %}
