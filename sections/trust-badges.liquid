<style>
  /* ========== TRUST BADGES SECTION ========== */
  .trust-section {
    padding: 32px 16px;
    background: var(--gray, #f3f3f3);
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .trust-item {
    text-align: center;
    padding: 16px;
    background: var(--white, #ffffff);
    border-radius: 8px;
  }

  .trust-icon {
    width: 40px;
    height: 40px;
    background: var(--blue, #2463af);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 10px;
  }

  .trust-icon svg {
    width: 20px;
    height: 20px;
    color: var(--white, #ffffff);
    stroke: var(--white, #ffffff);
  }

  .trust-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--dark, #1a1a1a);
    margin: 0 0 4px;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .trust-desc {
    font-size: 12px;
    color: var(--text-muted, #333333);
    margin: 0;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  /* Desktop Layout */
  @media (min-width: 768px) {
    .trust-section {
      padding: 60px 40px;
    }

    .trust-grid {
      grid-template-columns: repeat(4, 1fr);
      max-width: 1168px;
      margin: 0 auto;
      gap: 24px;
    }

    .trust-item {
      padding: 24px;
    }

    .trust-icon {
      width: 56px;
      height: 56px;
    }

    .trust-icon svg {
      width: 28px;
      height: 28px;
    }

    .trust-title {
      font-size: 16px;
    }

    .trust-desc {
      font-size: 13px;
    }
  }

  /* Afterpay Banner */
  .trust-afterpay {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 16px;
    background: var(--white, #ffffff);
    border-radius: 8px;
    margin-top: 16px;
    font-size: 14px;
    color: #1a1a1a;
    flex-wrap: wrap;
  }

  .trust-afterpay__logo {
    font-weight: 700;
    color: #000;
    font-size: 14px;
  }

  .trust-afterpay__link {
    color: #666;
    font-size: 12px;
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .trust-afterpay {
      max-width: 1168px;
      margin: 24px auto 0;
      font-size: 15px;
    }

    .trust-afterpay__logo {
      height: 20px;
    }
  }
</style>

<section class="trust-section">
  <div class="trust-grid">
    <div class="trust-item">
      <div class="trust-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
