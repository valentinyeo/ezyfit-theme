<div class="ezy ezy-bar" data-ezy-bar>
  <div class="ezy-bar__msgs">
    {%- for block in section.blocks -%}
      <p class="ezy-bar__msg{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
        {{ block.settings.text }}
        {%- if block.settings.link_text != blank and block.settings.link != blank %} <a href="{{ block.settings.link }}">{{ block.settings.link_text }}</a>{% endif %}
      </p>
    {%- endfor -%}
    {%- if section.blocks.size > 1 -%}
      <div class="ezy-bar__dots" aria-hidden="true">
        {%- for block in section.blocks -%}<span{% if forloop.first %} class="is-active"{% endif %}></span>{%- endfor -%}
      </div>
    {%- endif -%}
  </div>
  {%- if section.blocks.size > 1 -%}
    <button class="ezy-bar__pause" type="button" aria-label="Pause messages" data-ezy-pause>&#10074;&#10074;</button>
  {%- endif -%}
</div>
<script>
  (function () {
    var bar = document.querySelector('[data-ezy-bar]');
    if (!bar) return;
    var msgs = bar.querySelectorAll('.ezy-bar__msg');
    var dots = bar.querySelectorAll('.ezy-bar__dots span');
    if (msgs.length < 2) return;
    var i = 0, paused = false;
    function show(n) {
      msgs[i].classList.remove('is-active'); dots[i].classList.remove('is-active');
      i = n % msgs.length;
      msgs[i].classList.add('is-active'); dots[i].classList.add('is-active');
    }
    var t = setInterval(function () { if (!paused) show(i + 1); }, {{ section.settings.seconds | times: 1000 }});
    bar.querySelector('[data-ezy-pause]').addEventListener('click', function () {
      paused = !paused;
      this.innerHTML = paused ? '&#9654;' : '&#10074;&#10074;';
      this.setAttribute('aria-label', paused ? 'Play messages' : 'Pause messages');
    });
  })();
</script>

{% schema %}
{
  "name": "EZY announcement bar",
  "settings": [
    { "type": "range", "id": "seconds", "label": "Seconds per message", "min": 3, "max": 10, "step": 1, "default": 5 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "25% off every wiper, already in the price." },
        { "type": "text", "id": "link_text", "label": "Link text", "default": "Shop" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "EZY announcement bar" }]
}
{% endschema %}
