<style>
  .cb-gallery {
    background: var(--white, #ffffff);
    padding: 32px 16px 36px;
  }
  .cb-gallery-inner {
    max-width: 1168px;
    margin: 0 auto;
  }
  .cb-gallery-head {
    text-align: center;
    margin-bottom: 20px;
  }
  .cb-gallery-title {
    font-size: clamp(20px, 5.2vw, 30px);
    font-weight: 700;
    color: var(--dark, #1a1a1a);
    margin: 0;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }
  .cb-gallery-sub {
    font-size: 14px;
    color: var(--text-muted, #555);
    margin: 8px 0 0;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }
  .cb-gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }
  .cb-gallery-item {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 12px;
    background: #eef2f7;
  }
  .cb-gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .cb-gallery-item:hover img {
    transform: scale(1.05);
  }
  @media (min-width: 768px) {
    .cb-gallery {
      padding: 56px 40px 60px;
    }
    .cb-gallery-sub {
      font-size: 16px;
    }
    .cb-gallery-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
    }
  }
</style>

<section class="cb-gallery">
  <div class="cb-gallery-inner">
    <div class="cb-gallery-head">
      <h2 class="cb-gallery-title">{{ section.settings.heading | default: 'Real Click Blades on real Aussie cars' }}</h2>
      <p class="cb-gallery-sub">{{ section.settings.subheading | default: 'Fitted and photographed by actual customers' }}</p>
    </div>
    <div class="cb-gallery-grid">
      {% assign imgs = 'cb-real-1.jpg,cb-real-2.jpg,cb-real-3.jpg,cb-real-4.jpg,cb-real-5.jpg,cb-real-6.jpg,cb-real-7.jpg,cb-real-8.jpg' | split: ',' %}
      {% for img in imgs %}
        <div class="cb-gallery-item">
          <img src="{{ img | asset_url }}" alt="Click Blades fitted on a customer's car" loading="lazy" width="1000" height="1000">
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CB Gallery",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Click Blades on real Aussie cars"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Fitted and photographed by actual customers"
    }
  ],
  "presets": [
    {
      "name": "CB Gallery"
    }
  ]
}
{% endschema %}
