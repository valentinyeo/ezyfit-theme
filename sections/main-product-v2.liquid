<script>
  // Gallery functionality
  document.addEventListener('DOMContentLoaded', function () {
    const swiper = document.querySelector('.gallery-swiper');
    const dots = document.querySelectorAll('.gallery-dot');
    const thumbnails = document.querySelectorAll('.thumbnail');

    if (swiper) {
      // Update dots on scroll
      swiper.addEventListener('scroll', function () {
        const index = Math.round(swiper.scrollLeft / swiper.offsetWidth);
        updateActive(index);
      });

      // Dot click
      dots.forEach((dot) => {
        dot.addEventListener('click', function () {
          const index = parseInt(this.dataset.index);
          swiper.scrollTo({ left: index * swiper.offsetWidth, behavior: 'smooth' });
        });
      });

      // Thumbnail click
      thumbnails.forEach((thumb) => {
        thumb.addEventListener('click', function () {
          const index = parseInt(this.dataset.index);
          swiper.scrollTo({ left: index * swiper.offsetWidth, behavior: 'smooth' });
        });
      });

      function updateActive(index) {
        dots.forEach((d, i) => d.classList.toggle('active', i === index));
        thumbnails.forEach((t, i) => t.classList.toggle('active', i === index));
      }
    }

    // Quantity selector
    const qtyMinus = document.querySelector('.qty-btn.minus');
    const qtyPlus = document.querySelector('.qty-btn.plus');
    const qtyInput = document.querySelector('.quantity-input input');

    if (qtyMinus && qtyPlus && qtyInput) {
      qtyMinus.addEventListener('click', () => {
        const val = parseInt(qtyInput.value);
        if (val > 1) qtyInput.value = val - 1;
      });

      qtyPlus.addEventListener('click', () => {
        const val = parseInt(qtyInput.value);
        if (val < 10) qtyInput.value = val + 1;
      });
    }

    // Pickup availability toggle
    const pickupToggle = document.querySelector('.pickup-toggle');
    const pickupDetails = document.querySelector('.pickup-details');

    if (pickupToggle && pickupDetails) {
      pickupToggle.addEventListener('click', function () {
        const isExpanded = this.getAttribute('aria-expanded') === 'true';
        this.setAttribute('aria-expanded', !isExpanded);
        pickupDetails.style.display = isExpanded ? 'none' : 'block';
      });
    }

    // Add-on Add to Cart buttons
    const addonBtns = document.querySelectorAll('.addon-atc-btn');
    addonBtns.forEach((btn) => {
      btn.addEventListener('click', async function () {
        const variantId = this.dataset.variantId;
        if (!variantId) return;

        const originalText = this.querySelector('span').textContent;
        this.querySelector('span').textContent = 'Adding...';
        this.disabled = true;

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              items: [
                {
                  id: parseInt(variantId),
                  quantity: 1,
                },
              ],
            }),
          });

          if (response.ok) {
            this.querySelector('span').textContent = 'Added!';
            this.classList.add('addon-atc-btn--success');

            // Update cart count in header
            const cartResponse = await fetch('/cart.js');
            const cart = await cartResponse.json();
            const cartCountBtns = document.querySelectorAll('[data-cart-count], .cart-count-bubble span');
            cartCountBtns.forEach((el) => {
              el.textContent = cart.item_count;
            });

            // On desktop: open cart drawer. On mobile: just show success (don't redirect)
            const isMobile = window.innerWidth < 768;
            if (!isMobile) {
              const cartDrawer = document.querySelector('cart-drawer');
              if (cartDrawer && typeof cartDrawer.open === 'function') {
                cartDrawer.open();
              }
            }

            // Reset button after 2 seconds
            setTimeout(() => {
              this.querySelector('span').textContent = originalText;
              this.classList.remove('addon-atc-btn--success');
              this.disabled = false;
            }, 2000);
          } else {
            throw new Error('Failed to add to cart');
          }
        } catch (error) {
          console.error('Error adding to cart:', error);
          this.querySelector('span').textContent = 'Error';
          setTimeout(() => {
            this.querySelector('span').textContent = originalText;
            this.disabled = false;
          }, 2000);
        }
      });
    });

    // Add Complete Set button
    const addSetBtn = document.getElementById('add-complete-set');
    if (addSetBtn) {
      addSetBtn.addEventListener('click', async function () {
        const variantIds = this.dataset.variantIds.split(',').map((id) => parseInt(id.trim()));
        if (!variantIds.length) return;

        const originalHTML = this.innerHTML;
        this.innerHTML =
          '<svg viewBox="0 0 20 20" fill="currentColor" style="width:20px;height:20px;animation:spin 1s linear infinite"><circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="2" fill="none" opacity="0.3"/><path d="M10 2a8 8 0 018 8" stroke="currentColor" stroke-width="2" fill="none"/></svg> Adding...';
        this.disabled = true;

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              items: variantIds.map((id) => ({
                id: id,
                quantity: 1,
              })),
            }),
          });

          if (response.ok) {
            this.innerHTML =
              '<svg viewBox="0 0 20 20" fill="currentColor" style="width:20px;height:20px"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Added to Cart!';
            this.classList.add('addon-set-btn--success');

            // Update cart count
            const cartResponse = await fetch('/cart.js');
            const cart = await cartResponse.json();
            const cartCountBtns = document.querySelectorAll('[data-cart-count], .cart-count-bubble span');
            cartCountBtns.forEach((el) => {
              el.textContent = cart.item_count;
            });

            // On desktop: open cart drawer. On mobile: just show success (don't redirect)
            const isMobile = window.innerWidth < 768;
            if (!isMobile) {
              const cartDrawer = document.querySelector('cart-drawer');
              if (cartDrawer && typeof cartDrawer.open === 'function') {
                cartDrawer.open();
              }
            }

            // Reset after 3 seconds
            setTimeout(() => {
              this.innerHTML = originalHTML;
              this.classList.remove('addon-set-btn--success');
              this.disabled = false;
            }, 3000);
          } else {
            throw new Error('Failed to add to cart');
          }
        } catch (error) {
          console.error('Error adding set to cart:', error);
          this.innerHTML = 'Error - Try Again';
          setTimeout(() => {
            this.innerHTML = originalHTML;
            this.disabled = false;
          }, 2000);
        }
      });
    }
  });
</script>
{%- endunless -%}

