{%- comment -%}
  EZYFIT wiper collection grid. Renders only for wiper collections; other collections keep collection-product-grid-v7.
{%- endcomment -%}
{%- if collection.handle contains 'wiper' -%}
<section class="ezy ezy-sec ezy-coll">
  <div class="ezy-wrap">
    <h1 class="ezy-h2">{{ section.settings.heading | default: collection.title }}</h1>
    <p class="ezy-sub">{{ section.settings.sub }}</p>
    <div class="ezy-coll__find">
      <label class="visually-hidden" for="ezy-coll-q">Find your car</label>
      <input id="ezy-coll-q" type="search" placeholder="Type your car, for example Hilux" autocomplete="off" data-ezy-coll-q>
    </div>
    {%- comment -%}
      MACL-37 P52/P53: the live car picker, price and best-selling sort, and In Stock control,
      on the wiper collections. The picker is the live snippet unchanged; it fills itself from
      /collections/<handle>/products.json and /collections/<handle>?sections=filter-data, and
      sends the shopper to the matching product or to /search like it does on live.
    {%- endcomment -%}
    <div class="ezy-coll__tools collection-controls">
      <button type="button" class="ezy-coll__toggle" id="toolbar-picker-toggle" aria-expanded="false" aria-controls="coll-car-picker">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 12h1l2-5h12l2 5h1a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 11-4 0H8a2 2 0 11-4 0H3a1 1 0 01-1-1v-3a1 1 0 011-1z"/><circle cx="6" cy="17" r="1.5"/><circle cx="18" cy="17" r="1.5"/></svg>
        <span id="toolbar-picker-text">Find your car</span>
        <svg class="ezy-coll__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="ezy-coll__right">
        <label class="ezy-coll__stock">
          <input type="checkbox" id="filter-in-stock-desktop" data-url-on="{{ collection.url }}?filter.v.availability=1" data-url-off="{{ collection.url }}">
          <span>In Stock Only</span>
        </label>
        <div class="ezy-coll__sort">
          <label class="visually-hidden" for="SortBy">Sort by</label>
          <select name="sort_by" id="SortBy" data-ezy-sort>
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            {%- for option in collection.sort_options -%}
              <option value="{{ collection.url }}?sort_by={{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </div>
        <button type="button" class="ezy-coll__fs" data-ezy-fs aria-controls="ezy-fs">Filter &amp; Sort</button>
      </div>
    </div>
    {%- render 'collection-car-picker', collection_handle: collection.handle -%}
    <dialog class="ezy ezy-fs" id="ezy-fs" aria-label="Filter & Sort" hidden>
      <div class="ezy-fs__panel">
        <div class="ezy-fs__top">
          <h3>Filter &amp; Sort</h3>
          <button type="button" class="ezy-fs__close" aria-label="Close" data-ezy-fs-close>&times;</button>
        </div>
        <label class="ezy-coll__stock">
          <input type="checkbox" id="filter-in-stock-mobile" data-url-on="{{ collection.url }}?filter.v.availability=1" data-url-off="{{ collection.url }}">
          <span>In Stock Only</span>
        </label>
        <label class="ezy-fs__label" for="SortByMobile">Sort by</label>
        <select name="sort_by_mobile" id="SortByMobile" data-ezy-sort>
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          {%- for option in collection.sort_options -%}
            <option value="{{ collection.url }}?sort_by={{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </div>
    </dialog>
    {%- paginate collection.products by 96 -%}
      <p class="ezy-coll__count" aria-live="polite" data-ezy-coll-count>{{ collection.products_count }} cars</p>
      <ul class="ezy-coll__grid" role="list">
        {%- for p in collection.products -%}
          {%- assign eager = false -%}{%- if forloop.index < 5 -%}{%- assign eager = true -%}{%- endif -%}
          {%- render 'ezy-product-card', p: p, eager: eager -%}
        {%- endfor -%}
      </ul>
      <div class="ezy-coll__empty" data-ezy-coll-empty hidden>
        <p>No blades listed for that car yet.</p>
        <a class="ezy-btn ezy-btn--ghost" href="/pages/request-your-car">Request your car</a>
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="ezy-coll__pages" aria-label="Pages">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">Previous</a>{%- endif -%}
          <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
<script>
  (function () {
    var q = document.querySelector('[data-ezy-coll-q]');
    if (!q) return;
    var items = [].slice.call(document.querySelectorAll('.ezy-coll__item'));
    var count = document.querySelector('[data-ezy-coll-count]');
    var empty = document.querySelector('[data-ezy-coll-empty]');
    function norm(s) { return String(s).toLowerCase().replace(/[^a-z0-9 ]/g, ''); }
    function run() {
      var terms = norm(q.value).split(/\s+/).filter(Boolean);
      var shown = 0;
      items.forEach(function (li) {
        var hay = norm(li.dataset.search).replace(/ /g, '') + ' ' + norm(li.dataset.search);
        var ok = terms.every(function (t) { return hay.indexOf(t) > -1; });
        li.hidden = !ok; if (ok) shown++;
      });
      count.textContent = shown + (shown === 1 ? ' car' : ' cars');
      empty.hidden = shown > 0;
    }
    q.addEventListener('input', run);
    var pre = new URLSearchParams(location.search).get('car');
    if (pre) { q.value = pre; run(); }
  })();

  // In Stock and sort, the same two shopper controls live's toolbar carries (P52, P53).
  (function () {
    var params = new URLSearchParams(location.search);
    var inStock = params.get('filter.v.availability') === '1';
    document.querySelectorAll('#filter-in-stock-desktop, #filter-in-stock-mobile').forEach(function (box) {
      box.checked = inStock;
      box.addEventListener('change', function () { location.href = box.checked ? box.dataset.urlOn : box.dataset.urlOff; });
    });
    document.querySelectorAll('[data-ezy-sort]').forEach(function (sel) {
      sel.addEventListener('change', function () { location.href = sel.value; });
    });
    var picker = document.getElementById('coll-car-picker');
    var toggleBtn = document.getElementById('toolbar-picker-toggle');
    function syncToggle() { if (picker && toggleBtn) toggleBtn.setAttribute('aria-expanded', String(picker.classList.contains('expanded'))); }
    if (toggleBtn) toggleBtn.addEventListener('click', function () { setTimeout(syncToggle, 150); });
    document.addEventListener('DOMContentLoaded', function () { syncToggle(); setTimeout(syncToggle, 200); });
    var fs = document.getElementById('ezy-fs');
    if (!fs) return;
    document.querySelectorAll('[data-ezy-fs]').forEach(function (btn) {
      btn.addEventListener('click', function () { fs.hidden = false; fs.showModal(); });
    });
    function closeFs() { if (fs.open) fs.close(); fs.hidden = true; }
    fs.querySelectorAll('[data-ezy-fs-close]').forEach(function (el) { el.addEventListener('click', function () { closeFs(); }); });
    fs.addEventListener('cancel', function (event) { event.preventDefault(); closeFs(); });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "EZY collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (blank uses the collection title)" },
    { "type": "text", "id": "sub", "label": "Subheading", "default": "Pick your car. Every pair is made for that exact car and fits in 2 minutes." }
  ]
}
{% endschema %}
