{% comment %}
  Loox Reviews Carousel Widget
  Displays customer photo reviews in a carousel format
{% endcomment %}

<style>
  /* ========== LOOX REVIEWS SECTION ========== */
  .loox-reviews-section {
    padding: 40px 16px;
    background: var(--gray, #f8f9fa);
  }

  .loox-reviews-header {
    text-align: center;
    margin-bottom: 24px;
  }

  .loox-reviews-title {
    font-size: 22px;
    font-weight: 700;
    color: var(--dark, #1a1a1a);
    margin: 0 0 12px;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .loox-reviews-summary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .loox-summary-stars {
    display: flex;
    gap: 2px;
  }

  .loox-summary-stars svg {
    width: 18px;
    height: 18px;
    color: #fbbf24;
  }

  .loox-summary-text {
    font-size: 14px;
    color: var(--text-muted, #333333);
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  /* Loox Widget Customizations */
  #looxCarousel {
    max-width: 100%;
    margin: 0 auto;
  }

  /* Override Loox default styles for larger images */
  .loox-reviews-section .loox-carousel-slide img,
  .loox-reviews-section [class*="loox"] img {
    border-radius: 12px !important;
  }

  /* CTA Link */
  .loox-reviews-cta {
    text-align: center;
    margin-top: 24px;
  }

  .loox-reviews-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 600;
    color: var(--blue, #2463af);
    text-decoration: none;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    transition: color 0.2s;
  }

  .loox-reviews-link:hover {
    color: var(--blue-dark, #1a4f8c);
  }

  .loox-reviews-link svg {
    width: 16px;
    height: 16px;
  }

  /* Desktop Styles */
  @media (min-width: 768px) {
    .loox-reviews-section {
      padding: 60px 40px;
    }

    .loox-reviews-title {
      font-size: 28px;
    }

    .loox-summary-stars svg {
      width: 22px;
      height: 22px;
    }

    .loox-summary-text {
      font-size: 16px;
    }

    .loox-reviews-cta {
      margin-top: 32px;
    }

    .loox-reviews-link {
      font-size: 15px;
    }
  }
</style>

<section class="loox-reviews-section">
  <div class="loox-reviews-header">
    <h2 class="loox-reviews-title">{{ section.settings.heading | default: 'What Our Customers Say' }}</h2>
    {% if section.settings.show_rating_summary %}
    <div class="loox-reviews-summary">
      <div class="loox-summary-stars">
        <svg viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        <svg viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        <svg viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        <svg viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        <svg viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
      </div>
      <span class="loox-summary-text">{{ section.settings.rating_text | default: '5.0 out of 5 based on 11 reviews' }}</span>
    </div>
    {% endif %}
  </div>

  <!-- Loox Carousel Widget -->
  <div id="looxCarousel"
       data-show-more="{{ section.settings.show_more_button }}"
       {% if section.settings.carousel_type == 'gallery' %}data-slide-type="gallery"{% endif %}
       {% if section.settings.carousel_type == 'cards' %}data-slide-type="card"{% endif %}
       {% if section.settings.carousel_type == 'testimonial' %}data-slide-type="testimonial"{% endif %}
  ></div>

  {% if section.settings.show_all_reviews_link %}
  <div class="loox-reviews-cta">
    <a href="#qv" class="loox-reviews-link">
      {{ section.settings.cta_text | default: 'Read All Reviews' }}
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M7 4l6 6-6 6"/>
      </svg>
    </a>
  </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Loox Reviews Carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "checkbox",
      "id": "show_rating_summary",
      "label": "Show Rating Summary",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Summary Text",
      "default": "5.0 out of 5 based on 11 reviews"
    },
    {
      "type": "select",
      "id": "carousel_type",
      "label": "Carousel Type",
      "options": [
        { "value": "cards", "label": "Cards (Photos + Text)" },
        { "value": "gallery", "label": "Gallery (Large Photos)" },
        { "value": "testimonial", "label": "Testimonial (Text Focus)" }
      ],
      "default": "cards"
    },
    {
      "type": "checkbox",
      "id": "show_more_button",
      "label": "Show 'View More' Button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_all_reviews_link",
      "label": "Show 'Read All Reviews' Link",
      "default": true
    },
    {
      "type": "text",
      "id": "reviews_page_url",
      "label": "Reviews Page URL",
      "default": "/pages/happy-customers"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Read All Reviews"
    }
  ],
  "presets": [
    {
      "name": "Loox Reviews Carousel"
    }
  ]
}
{% endschema %}
