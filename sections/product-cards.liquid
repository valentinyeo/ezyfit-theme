<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<style>
  /* ========== SWIPEABLE PRODUCT CAROUSEL ========== */
  .product-carousel-section {
    padding: 0;
    background: var(--white, #ffffff);
  }

  .product-carousel-container {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-snap-type: x mandatory;
    scroll-padding-left: 16px;
  }

  .product-carousel-container::-webkit-scrollbar {
    display: none;
  }

  .product-carousel-track {
    display: flex;
    gap: 12px;
    padding: 16px 0;
  }

  .product-carousel-track::before,
  .product-carousel-track::after {
    content: '';
    flex-shrink: 0;
    width: 16px;
  }

  .product-carousel-card {
    flex: 0 0 85%;
    scroll-snap-align: start;
    background: var(--white, #ffffff);
    border: 1px solid var(--border, #e0e0e0);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .product-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
    flex-grow: 1;
  }

  .product-card-image {
    width: 100%;
    background: #f8f9fa;
  }

  .product-card-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .product-card-body {
    padding: 12px;
  }

  .product-card-name {
    font-size: 15px;
    font-weight: 700;
    color: var(--dark, #1a1a1a);
    margin: 0 0 6px;
    line-height: 1.3;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .product-card-rating {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 6px;
  }

  .product-card-stars {
    display: flex;
    gap: 1px;
  }

  .product-card-stars svg {
    width: 14px;
    height: 14px;
    color: #fbbf24;
  }

  .product-card-reviews {
    font-size: 12px;
    color: var(--text-muted, #333333);
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .product-card-price {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .product-card-price-current {
    font-size: 15px;
    font-weight: 700;
    color: var(--dark, #1a1a1a);
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .product-card-price-original {
    font-size: 15px;
    color: #cc0000;
    text-decoration: line-through;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .product-card-form {
    padding: 0 12px 12px;
    margin-top: auto;
  }

  .product-card-btn {
    display: block;
    width: 100%;
    padding: 12px;
    background: linear-gradient(180deg, #FFD814 0%, #F7CA00 100%);
    color: var(--dark, #1a1a1a);
    border: none;
    border-radius: 8px;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    box-sizing: border-box;
  }

  /* Desktop - show more cards */
  @media (min-width: 768px) {
    .product-carousel-section {
      padding: 0;
      max-width: 1168px;
      margin: 0 auto;
    }

    .product-carousel-container {
      scroll-padding-left: 24px;
    }

    .product-carousel-track {
      padding: 16px 0;
      gap: 16px;
    }

    .product-carousel-track::before,
    .product-carousel-track::after {
      width: 24px;
    }

    .product-carousel-card {
      flex: 0 0 45%;
    }

    .product-card-body {
      padding: 16px;
    }

    .product-card-name {
      font-size: 17px;
    }

    .product-card-price-current {
      font-size: 16px;
    }

    .product-card-price-original {
      font-size: 16px;
    }

    .product-card-form {
      padding: 0 16px 16px;
    }
  }

  @media (min-width: 1024px) {
    .product-carousel-container {
      overflow-x: visible;
    }

    .product-carousel-track {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      padding: 16px 24px;
    }

    .product-carousel-track::before,
    .product-carousel-track::after {
      display: none;
    }

    .product-carousel-card {
      flex: none;
      width: 100%;
    }

    .product-card-image img {
      height: auto;
    }

    .product-card-body {
      padding: 14px;
    }

    .product-card-name {
      font-size: 15px;
      white-space: normal;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }

    .product-card-price-current {
      font-size: 20px;
    }

    .product-card-price-original {
      font-size: 14px;
    }

    .product-card-form {
      padding: 0 14px 14px;
    }

    .product-card-btn {
      padding: 12px;
      font-size: 14px;
    }

    /* Desktop hover effect */
    .product-carousel-card {
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .product-carousel-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    }
  }
</style>

<section class="product-carousel-section">
  <div class="product-carousel-container">
    <div class="product-carousel-track">
      {% if section.settings.collection != blank %}
        {% assign products = collections[section.settings.collection].products %}
      {% else %}
        {% assign products = collections.all.products %}
      {% endif %}

      {% assign card_count = 0 %}
      {% for product in products %}
        {% if card_count >= 8 %}{% break %}{% endif %}
        {% if product.handle == 'front-windscreen-wipers-for-vw-golf-mk7-200-2013-2022' %}{% continue %}{% endif %}
        {% assign card_count = card_count | plus: 1 %}
        {% assign product_card_form_id = 'product-card-form-' | append: product.id %}
        <div class="product-carousel-card">
          <a href="{{ product.url }}" class="product-card-link">
            <div class="product-card-image">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
              {% else %}
                <img src="https://cdn.shopify.com/s/files/1/0000/0000/0000/files/placeholder-image.jpg" alt="{{ product.title | escape }}" loading="lazy">
              {% endif %}
            </div>
            <div class="product-card-body">
              <h3 class="product-card-name">{{ product.title }}</h3>
              <div class="product-card-rating">
                <!-- Loox Star Rating Widget -->
                <div class="loox-rating" data-id="{{ product.id }}" data-rating="{{ product.metafields.loox.avg_rating }}" data-raters="{{ product.metafields.loox.num_reviews }}"></div>
              </div>
              <div class="product-card-price{% if product.compare_at_price > product.price %} has-sale{% endif %}">
                <span class="product-card-price-current">{{ product.price | money }}</span>
                {% if product.compare_at_price > product.price %}
                  <span class="product-card-price-original">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </div>
            </div>
          </a>
          <div class="product-card-form">
            <a href="{{ product.url }}" class="product-card-btn view-product-btn">
              <span>View Product</span>
            </a>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Product Cards",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Product Cards"
    }
  ]
}
{% endschema %}
