{%- comment -%}
  MACL-37 P08: the four trust badges from the live Click Shades homepage, in the new look.
  Copy is the live wording, editable per block in the theme editor.
{%- endcomment -%}
<section class="ezy ezy-trust" aria-label="{{ section.settings.label | default: 'Why shoppers trust Click Shades' }}">
  <div class="ezy-wrap ezy-trust__grid">
    {%- for block in section.blocks -%}
      <div class="ezy-trust__item" {{ block.shopify_attributes }}>
        <span class="ezy-trust__icon" aria-hidden="true">
          {%- case block.settings.icon -%}
            {%- when 'sun' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
            {%- when 'tool' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            {%- when 'return' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.5 9a9 9 0 0 1 14.9-3.4L23 10M1 14l4.6 4.4A9 9 0 0 0 20.5 15"/></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.1V12a10 10 0 1 1-5.9-9.1"/><path d="M22 4 12 14l-3-3"/></svg>
          {%- endcase -%}
        </span>
        <h3 class="ezy-trust__title">{{ block.settings.title }}</h3>
        <p class="ezy-trust__desc">{{ block.settings.desc }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Trust badges",
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible label", "default": "Why shoppers trust Click Shades" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "desc", "label": "Description" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "fit", "label": "Check" },
            { "value": "sun", "label": "Sun" },
            { "value": "tool", "label": "Tool" },
            { "value": "return", "label": "Return arrow" }
          ],
          "default": "fit"
        }
      ]
    }
  ],
  "presets": [
    { "name": "Trust badges" }
  ]
}
{% endschema %}
