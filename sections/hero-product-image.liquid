{%- if section.settings.enable_product_image -%}
<section class="product-section">
  <div class="product-image">
    {% if section.settings.product_image %}
      {{ section.settings.product_image | img_url: '1200x' | img_tag: section.settings.image_alt }}
    {% else %}
      <img src="https://clickshades.com.au/cdn/shop/files/SideShade2.png?v=1762038252&width=1200" alt="{{ section.settings.image_alt }}">
    {% endif %}
  </div>
</section>
{%- endif -%}


<script>
document.addEventListener('DOMContentLoaded', function() {
  const heroVideoLink = document.getElementById('heroVideoLink');
  const heroLightbox = document.getElementById('heroVideoLightbox');
  const heroLightboxVideo = document.getElementById('heroLightboxVideo');
  const heroLightboxClose = heroLightbox?.querySelector('.hero-lightbox-close');
  const heroLightboxBackdrop = heroLightbox?.querySelector('.hero-lightbox-backdrop');

  function openHeroLightbox(e) {
    e.preventDefault();
    if (heroLightbox && heroLightboxVideo) {
      heroLightbox.classList.add('active');
      heroLightboxVideo.play();
      document.body.style.overflow = 'hidden';
    }
  }

  function closeHeroLightbox() {
    if (heroLightbox && heroLightboxVideo) {
      heroLightbox.classList.remove('active');
      heroLightboxVideo.pause();
      heroLightboxVideo.currentTime = 0;
      document.body.style.overflow = '';
    }
  }

  if (heroVideoLink) heroVideoLink.addEventListener('click', openHeroLightbox);
  if (heroLightboxClose) heroLightboxClose.addEventListener('click', closeHeroLightbox);
  if (heroLightboxBackdrop) heroLightboxBackdrop.addEventListener('click', closeHeroLightbox);

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && heroLightbox?.classList.contains('active')) {
      closeHeroLightbox();
    }
  });
});
</script>

{% schema %}
{
  "name": "Hero + Product Image",
  "settings": [
    {
      "type": "header",
      "content": "Hero Section"
    },
    {
      "type": "checkbox",
      "id": "enable_hero",
      "label": "Enable Hero Section",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "4.9 - Top Rated Car Shades"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "Snap-On Shades That Never Fall Off"
    },
    {
      "type": "text",
      "id": "hero_subtitle",
      "label": "Hero Subtitle",
      "default": "Guaranteed fit for your specific vehicle"
    },
    {
      "type": "header",
      "content": "Product Image Section"
    },
    {
      "type": "checkbox",
      "id": "enable_product_image",
      "label": "Enable Product Image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image Alt Text",
      "default": "ClickShades Car Window Shades"
    }
  ],
  "presets": [
    {
      "name": "Hero + Product Image"
    }
  ]
}
{% endschema %}