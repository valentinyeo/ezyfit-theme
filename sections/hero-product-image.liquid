<!-- Hero Video Lightbox (Cinema Mode) -->
<div class="hero-video-lightbox" id="heroVideoLightbox">
  <div class="hero-lightbox-backdrop" id="heroLightboxBackdrop"></div>
  <div class="hero-lightbox-content">
    <video id="heroLightboxVideo" controls playsinline>
      <source src="https://cdn.shopify.com/videos/c/o/v/183b9ee200c44eda82e1f183a8769fb7.mp4" type="video/mp4">
    </video>
    <button class="hero-lightbox-close" id="heroLightboxCloseBtn" aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
</div>
