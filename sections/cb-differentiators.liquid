<style>
  .cb-diff-section {
    padding: 40px 16px;
    background: var(--white, #ffffff);
  }

  .cb-diff-heading {
    text-align: center;
    font-size: 24px;
    font-weight: 700;
    color: var(--dark, #1a1a1a);
    margin: 0 0 32px;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .cb-diff-content {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .cb-diff-points {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .cb-diff-point {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .cb-diff-icon {
    width: 44px;
    height: 44px;
    min-width: 44px;
    background: var(--blue-light, #e8f1fb);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cb-diff-icon svg {
    width: 22px;
    height: 22px;
    stroke: var(--blue, #2463af);
  }

  .cb-diff-text h3 {
    font-size: 15px;
    font-weight: 700;
    color: var(--dark, #1a1a1a);
    margin: 0 0 4px;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .cb-diff-text p {
    font-size: 13px;
    color: var(--text-muted, #333333);
    margin: 0;
    line-height: 1.4;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .cb-diff-image {
    border-radius: 12px;
    overflow: hidden;
  }

  .cb-diff-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (min-width: 768px) {
    .cb-diff-section {
      padding: 60px 24px;
      max-width: 1168px;
      margin: 0 auto;
    }

    .cb-diff-heading {
      font-size: 32px;
      margin-bottom: 48px;
    }

    .cb-diff-content {
      flex-direction: row;
      align-items: center;
      gap: 60px;
    }

    .cb-diff-points {
      flex: 1;
      gap: 24px;
    }

    .cb-diff-icon {
      width: 52px;
      height: 52px;
      min-width: 52px;
    }

    .cb-diff-icon svg {
      width: 26px;
      height: 26px;
    }

    .cb-diff-text h3 {
      font-size: 16px;
    }

    .cb-diff-text p {
      font-size: 14px;
    }

    .cb-diff-image {
      flex: 1;
      max-width: 450px;
    }
  }
</style>

<section class="cb-diff-section">
  <h2 class="cb-diff-heading">{{ section.settings.heading | default: 'Why Choose Click Blades?' }}</h2>

  <div class="cb-diff-content">
    <div class="cb-diff-points">
      <!-- Precision Fit -->
      <div class="cb-diff-point">
        <div class="cb-diff-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <circle cx="12" cy="12" r="6"/>
            <circle cx="12" cy="12" r="2"/>
          </svg>
        </div>
        <div class="cb-diff-text">
          <h3>Precision Fit</h3>
          <p>Engineered for your exact vehicle model — no universal blades that don't quite fit</p>
        </div>
      </div>

      <!-- Easy Installation -->
      <div class="cb-diff-point">
        <div class="cb-diff-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
          </svg>
        </div>
        <div class="cb-diff-text">
          <h3>Easy Installation</h3>
          <p>Clip on in under 2 minutes, no tools required</p>
        </div>
      </div>

      <!-- All-Weather Performance -->
      <div class="cb-diff-point">
        <div class="cb-diff-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="16" y1="13" x2="16" y2="21"/>
            <line x1="8" y1="13" x2="8" y2="21"/>
            <line x1="12" y1="15" x2="12" y2="23"/>
            <path d="M20 16.58A5 5 0 0 0 18 7h-1.26A8 8 0 1 0 4 15.25"/>
          </svg>
        </div>
        <div class="cb-diff-text">
          <h3>All-Weather Performance</h3>
          <p>Streak-free visibility in rain, storms, and any conditions</p>
        </div>
      </div>
    </div>

    {% if section.settings.product_image %}
    <div class="cb-diff-image">
      {{ section.settings.product_image | img_url: '800x' | img_tag: section.settings.image_alt }}
    </div>
    {% elsif template.suffix == 'clickblades-v3' or template.suffix == 'clickblades' %}
    <div class="cb-diff-image">
      <img src="{{ 'cb-real-1.jpg' | asset_url }}" alt="Click Blades fitted on a customer's car" width="1000" height="1000" loading="lazy">
    </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "CB Differentiators",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose Click Blades?"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image (optional)"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image Alt Text",
      "default": "Click Blades Wiper Blades"
    }
  ],
  "presets": [
    {
      "name": "CB Differentiators"
    }
  ]
}
{% endschema %}
