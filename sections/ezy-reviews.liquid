{%- comment -%}
  Reviews and customer photos. Add the Loox app block in the theme editor; it replaces the placeholder cards.
{%- endcomment -%}
{%- liquid
  assign has_app = false
  for block in section.blocks
    if block.type == '@app'
      assign has_app = true
    endif
  endfor
-%}
<section class="ezy ezy-sec{% if section.settings.rule %} ezy-sec--rule{% endif %}"{% if section.settings.style == 'loox' %} id="ezy-reviews"{% endif %}>
  <div class="ezy-wrap">
    <h2 class="ezy-h2">{{ section.settings.heading }}</h2>
    <p class="ezy-sub">{{ section.settings.sub }}</p>
    {%- if has_app -%}
      {%- for block in section.blocks -%}{%- if block.type == '@app' -%}{% render block %}{%- endif -%}{%- endfor -%}
    {%- elsif section.settings.style == 'photos' -%}
      {%- assign photos = section.settings.photo_assets | split: ',' -%}
      <div class="ezy-photos">
        {%- for f in photos -%}
          {%- assign f = f | strip -%}
          <div class="ezy-photo">{% render 'ezy-customer-photo', file: f, alt: section.settings.photo_alt %}</div>
        {%- endfor -%}
      </div>
    {%- elsif section.settings.style == 'loox' -%}
      {%- comment -%} The Loox app script fills #looxReviews on any store with Loox installed. {%- endcomment -%}
      <div class="ezy-loox"><div id="looxReviews"></div></div>
      {%- if section.settings.all_link != blank -%}
        <a class="ezy-btn ezy-btn--ghost ezy-loox__all" href="{{ section.settings.all_link }}">{{ section.settings.all_text }}</a>
      {%- endif -%}
    {%- else -%}
      <div class="ezy-reviews">
        {%- for i in (1..3) -%}
          <div class="ezy-card ezy-review">
            <div class="ezy-review__stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <p>Real Loox review goes here. Picked from reviews that name the car.</p>
            <small>Verified buyer, Ford Ranger</small>
          </div>
        {%- endfor -%}
      </div>
      <p class="ezy-note">Placeholder cards, to be filled with live Loox reviews.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "EZY reviews",
  "settings": [
    { "type": "select", "id": "style", "label": "Placeholder style", "options": [{ "value": "cards", "label": "Review cards" }, { "value": "photos", "label": "Photo tiles" }, { "value": "loox", "label": "Live Loox reviews" }], "default": "loox" },
    { "type": "text", "id": "photo_assets", "label": "Photo files (theme assets, comma separated)", "default": "cb-real-1.jpg,cb-real-3.jpg,cb-real-4.jpg,cb-real-5.jpg,cb-real-7.jpg,cb-real-8.jpg" },
    { "type": "text", "id": "photo_alt", "label": "Photo alt text", "default": "Blades fitted on a customer's car" },
    { "type": "url", "id": "all_link", "label": "All reviews link" },
    { "type": "text", "id": "all_text", "label": "All reviews button", "default": "Read all reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What drivers say" },
    { "type": "text", "id": "sub", "label": "Subheading", "default": "Real reviews from verified buyers." },
    { "type": "checkbox", "id": "rule", "label": "Blue line on top", "default": false }
  ],
  "blocks": [{ "type": "@app" }]
}
{% endschema %}
