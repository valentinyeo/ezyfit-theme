<style>
  /* ========== COLLECTION CAR SELECTOR (Compact) ========== */
  .coll-selector {
    padding: 8px 16px 6px;
    max-width: 100%;
    box-sizing: border-box;
    background: #f8fafc;
    border-bottom: 1px solid var(--border, #e0e0e0);
  }

  .coll-selector-inner {
    max-width: 900px;
    margin: 0 auto;
  }

  .coll-selector-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted, #666666);
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* ========== YMM FORM ========== */
  .coll-ymm-form {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* ========== CUSTOM DROPDOWN ========== */
  .coll-dropdown {
    position: relative;
    width: 100%;
  }

  .coll-dropdown-trigger {
    width: 100%;
    padding: 8px 12px;
    border: 1px solid var(--border, #e0e0e0);
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted, #333333);
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: var(--white, #ffffff);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .coll-dropdown-trigger:hover:not(.disabled) {
    border-color: var(--blue, #2463af);
  }

  .coll-dropdown.active-step .coll-dropdown-trigger:not(.disabled) {
    border: 2px solid var(--blue, #2463af);
    background: #f8fafc;
    box-shadow: 0 0 0 2px rgba(36, 99, 175, 0.15);
  }

  .coll-dropdown.active-step .coll-dropdown-value:not(.selected) {
    color: var(--blue, #2463af);
    font-weight: 600;
  }

  .coll-dropdown-trigger.disabled {
    opacity: 0.6;
    cursor: not-allowed;
    background: #f0f0f0;
  }

  .coll-dropdown.open .coll-dropdown-trigger {
    border-color: var(--blue, #2463af);
    box-shadow: 0 0 0 2px rgba(36, 99, 175, 0.15);
  }

  .coll-dropdown-value {
    flex: 1;
    text-align: left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .coll-dropdown-value.selected {
    color: var(--text, #333333);
  }

  .coll-dropdown-arrow {
    width: 16px;
    height: 16px;
    stroke: #666;
    transition: transform 0.2s;
    flex-shrink: 0;
    margin-left: 4px;
  }

  .coll-dropdown.open .coll-dropdown-arrow {
    transform: rotate(180deg);
  }

  /* ========== DROPDOWN MENU ========== */
  .coll-dropdown-menu {
    position: absolute;
    top: calc(100% + 2px);
    left: 0;
    right: 0;
    background: var(--white, #ffffff);
    border: 1px solid var(--border, #e0e0e0);
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    z-index: 1000;
    display: none;
    max-height: 280px;
    overflow: hidden;
    flex-direction: column;
  }

  .coll-dropdown.open .coll-dropdown-menu {
    display: flex;
  }

  /* ========== SEARCH INPUT ========== */
  .coll-dropdown-search {
    padding: 8px 10px;
    border-bottom: 1px solid var(--border, #e0e0e0);
    flex-shrink: 0;
  }

  .coll-dropdown-search input {
    width: 100%;
    padding: 8px 10px;
    border: 1px solid var(--border, #e0e0e0);
    border-radius: 6px;
    font-size: 13px;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    outline: none;
    transition: border-color 0.2s;
    box-sizing: border-box;
  }

  .coll-dropdown-search input:focus {
    border-color: var(--blue, #2463af);
  }

  .coll-dropdown-search input::placeholder {
    color: #999;
  }

  /* ========== OPTIONS LIST ========== */
  .coll-dropdown-options {
    overflow-y: auto;
    max-height: 200px;
    padding: 4px 0;
  }

  .coll-dropdown-option {
    padding: 10px 14px;
    font-size: 14px;
    color: #1a1a1a;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .coll-dropdown-option:hover {
    background: #e3f0ff;
  }

  .coll-dropdown-option.active {
    background: var(--blue, #2463af);
    color: white;
    font-weight: 700;
  }

  .coll-dropdown-loading,
  .coll-dropdown-empty {
    padding: 12px;
    text-align: center;
    color: #666;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 13px;
  }

  /* ========== SUBMIT BUTTON ========== */
  .coll-ymm-submit {
    width: 100%;
    padding: 10px;
    background: var(--yellow, #ffd600);
    color: var(--dark, #1a1a1a);
    border: none;
    border-radius: 6px;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s, opacity 0.2s;
  }

  .coll-ymm-submit:hover {
    background: var(--yellow-hover, #e6c100);
  }

  .coll-ymm-submit.incomplete {
    opacity: 0.85;
  }

  /* ========== DESKTOP LAYOUT ========== */
  @media (min-width: 768px) {
    .coll-selector {
      padding: 10px 40px 8px;
    }

    .coll-selector-label {
      margin-bottom: 8px;
      font-size: 12px;
    }

    .coll-ymm-form {
      display: grid;
      grid-template-columns: repeat(3, 1fr) auto;
      gap: 10px;
      align-items: stretch;
    }

    .coll-dropdown-trigger {
      height: 42px;
      padding: 0 12px;
      font-size: 14px;
    }

    .coll-ymm-submit {
      width: auto;
      height: 42px;
      padding: 0 24px;
      white-space: nowrap;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .coll-dropdown-menu {
      min-width: 200px;
    }
  }
</style>

<section class="coll-selector" id="coll-car-selector" data-collection-handle="{{ collection.handle }}">
  <div class="coll-selector-inner">
    <div class="coll-selector-label">Find your car</div>
    <div class="coll-ymm-form" id="coll-ymm-form">
      <!-- Make Dropdown -->
      <div class="coll-dropdown" data-field="make">
        <div class="coll-dropdown-trigger" data-placeholder="Select Make">
          <span class="coll-dropdown-value">Select Make</span>
          <svg class="coll-dropdown-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>
        <div class="coll-dropdown-menu">
          <div class="coll-dropdown-search">
            <input type="text" placeholder="Search make..." autocomplete="off">
          </div>
          <div class="coll-dropdown-options"></div>
        </div>
      </div>

      <!-- Model Dropdown -->
      <div class="coll-dropdown" data-field="model">
        <div class="coll-dropdown-trigger disabled" data-placeholder="Select Model">
          <span class="coll-dropdown-value">Select Model</span>
          <svg class="coll-dropdown-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>
        <div class="coll-dropdown-menu">
          <div class="coll-dropdown-search">
            <input type="text" placeholder="Search model..." autocomplete="off">
          </div>
          <div class="coll-dropdown-options"></div>
        </div>
      </div>

      <!-- Year Dropdown -->
      <div class="coll-dropdown" data-field="year">
        <div class="coll-dropdown-trigger disabled" data-placeholder="Select Year">
          <span class="coll-dropdown-value">Select Year</span>
          <svg class="coll-dropdown-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>
        <div class="coll-dropdown-menu">
          <div class="coll-dropdown-search">
            <input type="text" placeholder="Search year..." autocomplete="off">
          </div>
          <div class="coll-dropdown-options"></div>
        </div>
      </div>

      <!-- Submit Button -->
      <button type="button" class="coll-ymm-submit" id="coll-ymm-submit">
        {{ section.settings.button_text | default: 'Find Your Car' }}
      </button>
    </div>
  </div>
</section>

<script>
  (function () {
    const SECTION = document.getElementById('coll-car-selector');
    if (!SECTION) return;

    const collectionHandle = SECTION.dataset.collectionHandle;

    // Brand collections mapping (collection handle -> display name)
    const brandCollections = {
      'sun-shade-for-car-wiper-bladess-for-toyota': 'Toyota',
      'sun-shade-for-car-wiper-bladess-for-ford': 'Ford',
      'sun-shade-for-car-wiper-bladess-for-mazda': 'Mazda',
      'car-windscreen-shade-windscreen-wiper-blades-for-honda': 'Honda',
      'sun-shade-for-car-wiper-bladess-for-hyundai': 'Hyundai',
      'sun-shade-for-car-wiper-bladess-for-nissan': 'Nissan',
      'sun-shade-for-car-wiper-bladess-for-mitsubishi': 'Mitsubishi',
      'sun-shade-for-car-wiper-bladess-for-kia': 'Kia',
      'car-window-sun-shades-wiper-blade-for-bmw': 'BMW',
      'sun-shade-for-car-wiper-bladess-for-mercedes': 'Mercedes-Benz',
      'sun-shade-for-car-wiper-bladess-for-volkswagen': 'Volkswagen',
      'sun-shade-for-car-good-wiper-blades-for-subaru': 'Subaru',
      'car-windscreen-shade-windscreen-wiper-blades-for-isuzu': 'Isuzu',
      'sun-shade-for-car-wiper-bladess-for-lexus': 'Lexus',
      'sunshades-for-car-windows-wiper-blade-for-mg': 'MG',
      'sun-shade-for-car-wiper-bladess-for-chevrolet': 'Chevrolet',
      'sun-shade-for-car-wiper-bladess-for-geely': 'Geely',
      'sun-shade-for-car-wiper-bladess-for-infiniti': 'Infiniti',
      'sun-shade-for-car-wiper-bladess-for-byd': 'BYD',
    };

    // Reverse lookup: handle -> brand name
    const handleToBrand = {};
    Object.entries(brandCollections).forEach(([handle, name]) => {
      handleToBrand[handle] = name;
    });

    // Model name synonyms
    const modelAliases = {
      'Land Cruiser 250': 'Prado 250',
      'Land Cruiser 300': 'Land Cruiser 300',
      'Land Cruiser 200': 'Land Cruiser 200',
      'Land Cruiser Prado 150': 'Prado 150',
      'Land Cruiser Prado 250': 'Prado 250',
      'Land Cruiser Troop Carrier 70': 'Land Cruiser Troop Carrier 70',
    };

    // Detect if current collection is a brand collection
    const preselectedBrand = handleToBrand[collectionHandle] || null;

    let ymmData = {
      collections: {},
      models: {},
      years: {},
    };

    let selections = {
      make: null,
      makeHandle: null,
      model: null,
      year: null,
      matchingProducts: [],
    };

    // Scoped selectors — only query within our section
    function qs(sel) { return SECTION.querySelector(sel); }
    function qsa(sel) { return SECTION.querySelectorAll(sel); }

    function parseProductTitle(title, brandName) {
      let cleaned = title
        .replace(/^Front Windscreen (Shade|Wipers|Click Shade|Click Shades|Shades) for /i, '')
        .replace(/^Rear Side Windows Click Shades for /i, '')
        .replace(/^Rear Side Windows Shades for /i, '');

      const brandRegex = new RegExp('^' + brandName.replace('-', '[-\\s]?') + '\\s*', 'i');
      cleaned = cleaned.replace(brandRegex, '');

      let years = [];
      let model = cleaned;

      const openEndMatch = cleaned.match(/(\d{4})\s*->\s*$/);
      if (openEndMatch) {
        const startYear = parseInt(openEndMatch[1]);
        const currentYear = new Date().getFullYear();
        for (let y = startYear; y <= currentYear; y++) {
          years.push(y.toString());
        }
        model = cleaned.replace(/\s*\d{4}\s*->\s*$/, '').trim();
      } else {
        const rangeMatch = cleaned.match(/(\d{4})\s*[-–]\s*(\d{4})/);
        if (rangeMatch) {
          const startYear = parseInt(rangeMatch[1]);
          const endYear = parseInt(rangeMatch[2]);
          for (let y = startYear; y <= endYear; y++) {
            years.push(y.toString());
          }
          model = cleaned.replace(/\s*\d{4}\s*[-–]\s*\d{4}\s*$/, '').trim();
        } else {
          const singleMatch = cleaned.match(/(\d{4})\s*$/);
          if (singleMatch) {
            years.push(singleMatch[1]);
            model = cleaned.replace(/\s*\d{4}\s*$/, '').trim();
          }
        }
      }

      model = model.trim();
      return { model, years };
    }

    async function fetchCollectionProducts(collHandle) {
      try {
        const response = await fetch('/collections/' + collHandle + '/products.json?limit=250');
        const data = await response.json();
        return data.products || [];
      } catch (error) {
        return [];
      }
    }

    function processProductsForBrand(products, brandName) {
      const models = {};
      const years = {};

      products.forEach(function (product) {
        const parsed = parseProductTitle(product.title, brandName);
        if (parsed.model) {
          const canonicalModel = modelAliases[parsed.model] || parsed.model;
          if (!models[canonicalModel]) models[canonicalModel] = [];
          models[canonicalModel].push(product);

          const key = brandName + '_' + canonicalModel;
          if (!years[key]) years[key] = new Set();
          parsed.years.forEach(function (y) { years[key].add(y); });
        }
      });

      ymmData.models[brandName] = models;
      Object.assign(ymmData.years, years);
    }

    function populateMakes() {
      var dropdown = qs('[data-field="make"]');
      var optionsContainer = dropdown.querySelector('.coll-dropdown-options');

      var sortedBrands = Object.entries(brandCollections)
        .map(function (entry) { return { handle: entry[0], name: entry[1] }; })
        .sort(function (a, b) { return a.name.localeCompare(b.name); });

      sortedBrands.forEach(function (brand) {
        ymmData.collections[brand.name] = brand.handle;
      });

      optionsContainer.innerHTML = sortedBrands
        .map(function (b) { return '<div class="coll-dropdown-option" data-value="' + b.name + '">' + b.name + '</div>'; })
        .join('');

      attachOptionListeners(dropdown);
      updateActiveStep();
    }

    async function populateModels(make) {
      var dropdown = qs('[data-field="model"]');
      var optionsContainer = dropdown.querySelector('.coll-dropdown-options');
      var trigger = dropdown.querySelector('.coll-dropdown-trigger');

      if (!make) {
        optionsContainer.innerHTML = '';
        trigger.classList.add('disabled');
        resetDropdown(dropdown);
        return;
      }

      optionsContainer.innerHTML = '<div class="coll-dropdown-loading">Loading models...</div>';
      trigger.classList.remove('disabled');

      var collHandle = ymmData.collections[make];
      var products = await fetchCollectionProducts(collHandle);
      processProductsForBrand(products, make);

      var models = ymmData.models[make] || {};
      var sortedModels = Object.keys(models).sort();

      if (sortedModels.length === 0) {
        optionsContainer.innerHTML = '<div class="coll-dropdown-empty">No models found</div>';
        return;
      }

      optionsContainer.innerHTML = sortedModels
        .map(function (m) { return '<div class="coll-dropdown-option" data-value="' + m + '">' + m + '</div>'; })
        .join('');

      attachOptionListeners(dropdown);
    }

    async function fetchMetafieldYears(collHandle, make) {
      try {
        var params = new URLSearchParams({
          sections: 'filter-data',
          'filter.p.m.custom.vehicles_make': make,
        });
        var response = await fetch('/collections/' + collHandle + '?' + params);
        var data = await response.json();
        var html = data['filter-data'] || '';
        var parser = new DOMParser();
        var doc = parser.parseFromString(html, 'text/html');
        return Array.from(doc.querySelectorAll('[data-year]')).map(function (el) { return el.dataset.year; });
      } catch (error) {
        return null;
      }
    }

    async function populateYears(make, model) {
      var dropdown = qs('[data-field="year"]');
      var optionsContainer = dropdown.querySelector('.coll-dropdown-options');
      var trigger = dropdown.querySelector('.coll-dropdown-trigger');

      if (!make || !model) {
        optionsContainer.innerHTML = '';
        trigger.classList.add('disabled');
        resetDropdown(dropdown);
        return;
      }

      optionsContainer.innerHTML = '<div class="coll-dropdown-loading">Loading years...</div>';
      trigger.classList.remove('disabled');

      var key = make + '_' + model;
      var titleYears = new Set(Array.from(ymmData.years[key] || []));

      var collHandle = ymmData.collections[make];
      var metafieldYears = await fetchMetafieldYears(collHandle, make);

      var years;
      if (metafieldYears && metafieldYears.length > 0) {
        var metafieldSet = new Set(metafieldYears);
        years = Array.from(titleYears).filter(function (y) { return metafieldSet.has(y); });
      } else {
        years = Array.from(titleYears);
      }

      if (years.length === 0) {
        optionsContainer.innerHTML = '<div class="coll-dropdown-empty">No years found</div>';
        return;
      }

      var sortedYears = years.sort(function (a, b) { return b - a; });
      optionsContainer.innerHTML = sortedYears
        .map(function (y) { return '<div class="coll-dropdown-option" data-value="' + y + '">' + y + '</div>'; })
        .join('');

      attachOptionListeners(dropdown);
    }

    function updateActiveStep() {
      qsa('.coll-dropdown').forEach(function (d) { d.classList.remove('active-step'); });

      if (!selections.make) {
        qs('[data-field="make"]').classList.add('active-step');
      } else if (!selections.model) {
        qs('[data-field="model"]').classList.add('active-step');
      } else if (!selections.year) {
        qs('[data-field="year"]').classList.add('active-step');
      }
    }

    function resetDropdown(dropdown) {
      var trigger = dropdown.querySelector('.coll-dropdown-trigger');
      var valueEl = trigger.querySelector('.coll-dropdown-value');
      var searchInput = dropdown.querySelector('.coll-dropdown-search input');

      valueEl.textContent = trigger.dataset.placeholder;
      valueEl.classList.remove('selected');
      if (searchInput) searchInput.value = '';

      var field = dropdown.dataset.field;
      selections[field] = null;
    }

    function attachOptionListeners(dropdown) {
      var options = dropdown.querySelectorAll('.coll-dropdown-option');
      var field = dropdown.dataset.field;

      options.forEach(function (option) {
        option.addEventListener('click', async function () {
          var value = option.dataset.value;
          selectOption(dropdown, value);

          if (field === 'make') {
            selections.make = value;
            selections.makeHandle = ymmData.collections[value];
            selections.model = null;
            selections.year = null;
            resetDropdown(qs('[data-field="model"]'));
            resetDropdown(qs('[data-field="year"]'));
            await populateModels(value);
            qs('[data-field="year"] .coll-dropdown-trigger').classList.add('disabled');
            setTimeout(function () {
              openDropdown(qs('[data-field="model"]'));
            }, 50);
          } else if (field === 'model') {
            selections.model = value;
            selections.year = null;
            resetDropdown(qs('[data-field="year"]'));
            await populateYears(selections.make, value);
            setTimeout(function () {
              openDropdown(qs('[data-field="year"]'));
            }, 50);
          } else if (field === 'year') {
            selections.year = value;
            var models = ymmData.models[selections.make] || {};
            selections.matchingProducts = (models[selections.model] || []).filter(function (p) {
              var parsed = parseProductTitle(p.title, selections.make);
              return parsed.years.includes(value);
            });
          }

          updateActiveStep();
          updateSubmitButton();
          closeDropdown(dropdown);
          saveSelections();
        });
      });
    }

    function saveSelections() {
      try {
        sessionStorage.setItem('coll_ymm_selections', JSON.stringify({
          make: selections.make,
          makeHandle: selections.makeHandle,
          model: selections.model,
          year: selections.year
        }));
      } catch (e) {}
    }

    function selectOption(dropdown, value) {
      var trigger = dropdown.querySelector('.coll-dropdown-trigger');
      var valueEl = trigger.querySelector('.coll-dropdown-value');

      valueEl.textContent = value;
      valueEl.classList.add('selected');

      dropdown.querySelectorAll('.coll-dropdown-option').forEach(function (opt) {
        opt.classList.toggle('active', opt.dataset.value === value);
      });
    }

    function updateSubmitButton() {
      var btn = qs('#coll-ymm-submit');
      var isComplete = selections.make && selections.model && selections.year;
      btn.classList.toggle('incomplete', !isComplete);
    }

    function openDropdown(dropdown) {
      var trigger = dropdown.querySelector('.coll-dropdown-trigger');
      if (trigger.classList.contains('disabled')) return;

      qsa('.coll-dropdown.open').forEach(function (d) {
        if (d !== dropdown) closeDropdown(d);
      });

      dropdown.classList.add('open');
      var searchInput = dropdown.querySelector('.coll-dropdown-search input');
      if (searchInput && window.innerWidth >= 768) {
        setTimeout(function () { searchInput.focus(); }, 10);
      }
    }

    function closeDropdown(dropdown) {
      dropdown.classList.remove('open');
      var searchInput = dropdown.querySelector('.coll-dropdown-search input');
      if (searchInput) {
        searchInput.value = '';
        filterOptions(dropdown, '');
      }
    }

    function filterOptions(dropdown, query) {
      var options = dropdown.querySelectorAll('.coll-dropdown-option');
      var lowerQuery = query.toLowerCase();

      options.forEach(function (option) {
        var text = option.textContent.toLowerCase();
        option.style.display = text.includes(lowerQuery) ? '' : 'none';
      });
    }

    function handleSubmit() {
      if (!selections.make) {
        openDropdown(qs('[data-field="make"]'));
        return;
      }
      if (!selections.model) {
        openDropdown(qs('[data-field="model"]'));
        return;
      }
      if (!selections.year) {
        openDropdown(qs('[data-field="year"]'));
        return;
      }

      var matches = selections.matchingProducts;
      if (matches.length === 1) {
        window.location.href = '/products/' + matches[0].handle;
      } else {
        var query = selections.make + ' ' + selections.model;
        window.location.href = '/search?type=product&q=' + encodeURIComponent(query);
      }
    }

    // Pre-select brand if on a brand collection page
    async function preselect() {
      if (!preselectedBrand) return;

      var makeDropdown = qs('[data-field="make"]');
      selectOption(makeDropdown, preselectedBrand);
      selections.make = preselectedBrand;
      selections.makeHandle = ymmData.collections[preselectedBrand];
      await populateModels(preselectedBrand);
      updateActiveStep();
      updateSubmitButton();
    }

    function init() {
      qs('#coll-ymm-submit').classList.add('incomplete');

      populateMakes();

      // Pre-select brand based on collection handle
      preselect();

      // Dropdown trigger clicks
      qsa('.coll-dropdown-trigger').forEach(function (trigger) {
        trigger.addEventListener('click', function (e) {
          e.stopPropagation();
          var dropdown = trigger.closest('.coll-dropdown');
          if (dropdown.classList.contains('open')) {
            closeDropdown(dropdown);
          } else {
            openDropdown(dropdown);
          }
        });
      });

      // Search input handling
      qsa('.coll-dropdown-search input').forEach(function (input) {
        input.addEventListener('input', function (e) {
          var dropdown = input.closest('.coll-dropdown');
          filterOptions(dropdown, e.target.value);
        });
        input.addEventListener('click', function (e) {
          e.stopPropagation();
        });
      });

      // Close dropdowns on outside click
      document.addEventListener('click', function (e) {
        if (!e.target.closest('.coll-dropdown')) {
          qsa('.coll-dropdown.open').forEach(closeDropdown);
        }
      });

      // Submit button
      qs('#coll-ymm-submit').addEventListener('click', function (e) {
        e.stopPropagation();
        handleSubmit();
      });

      // Escape key
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          qsa('.coll-dropdown.open').forEach(closeDropdown);
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

