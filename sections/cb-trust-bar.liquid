    },
    {
      "type": "header",
      "content": "Badge 3"
    },
    {
      "type": "text",
      "id": "badge_3_title",
      "label": "Title",
      "default": "100% Australian Owned"
    },
    {
      "type": "text",
      "id": "badge_3_desc",
      "label": "Description",
      "default": "Shipped from WA"
    },
    {
      "type": "header",
      "content": "Badge 4"
