<style>
  /* ========== ROOT VARIABLES ========== */
  :root {
    --font-primary: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --blue: #2463af;
    --blue-dark: #1a4f8c;
    --blue-light: #e8f1fb;
    --yellow: #ffd600;
    --yellow-hover: #e6c100;
    --black: #000000;
    --dark: #1a1a1a;
    --text: #333333;
    --text-muted: #666666;
    --gray: #f3f3f3;
    --border: #e0e0e0;
    --white: #ffffff;
  }

  /* ========== COLLECTION HEADER SECTION ========== */
  .collection-header {
    background: linear-gradient(180deg, var(--blue-light) 0%, var(--white) 100%);
    padding: 8px 16px 4px;
  }

  .collection-header-container {
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
  }

  /* Breadcrumb Navigation */
  .breadcrumb {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 4px;
    font-size: 12px;
    font-family: var(--font-primary);
  }

  .breadcrumb a {
    color: var(--blue);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover {
    color: var(--blue-dark);
    text-decoration: underline;
  }

  .breadcrumb-separator {
    color: var(--text-muted);
    font-weight: 300;
  }

  .breadcrumb-current {
    color: var(--dark);
    font-weight: 600;
  }

  /* Collection Title */
  .collection-title {
    font-size: 20px;
    font-weight: 700;
    color: var(--dark);
    margin: 0;
    line-height: 1.2;
    font-family: var(--font-primary);
  }

  /* Collection Description - hidden on mobile */
  .collection-description {
    display: none;
    font-size: 15px;
    color: var(--text-muted);
    margin: 8px 0 0;
    line-height: 1.5;
    font-family: var(--font-primary);
    font-weight: 400;
  }

  .collection-description p {
    margin: 0;
  }

  /* ========== TABLET & DESKTOP ========== */
  @media (min-width: 768px) {
    .collection-header {
      padding: 16px 40px 8px;
    }

    .collection-header-container {
      padding: 0 20px;
    }

    .breadcrumb {
      margin-bottom: 8px;
      font-size: 13px;
    }

    .collection-title {
      font-size: 32px;
      margin-bottom: 4px;
      max-width: 800px;
      margin-left: auto;
      margin-right: auto;
    }

    .collection-description {
      display: block;
      font-size: 15px;
      margin-top: 8px;
      max-width: 700px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media (min-width: 1024px) {
    .collection-header {
      padding: 16px 40px 8px;
    }

    .collection-title {
      font-size: 32px;
    }

    .collection-description {
      font-size: 16px;
    }
  }
</style>


<section class="collection-header">
  <div class="collection-header-container">
    <!-- Breadcrumb Navigation -->
    {%- if section.settings.show_breadcrumb -%}
      <nav class="breadcrumb" aria-label="breadcrumbs">
        <a href="/">Home</a>
        <span class="breadcrumb-separator">/</span>
        <span class="breadcrumb-current">{{ collection.title }}</span>
      </nav>
    {%- endif -%}

    <!-- Collection Title -->
    <h1 class="collection-title">
      {{ collection.title | escape }}
    </h1>

    <!-- Collection Description (desktop only) -->
    {%- if collection.description and section.settings.show_description -%}
      <div class="collection-description">
        {{ collection.description }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection Header",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show Breadcrumb Navigation",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show Collection Description",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Collection Header"
    }
  ]
}
{% endschema %}
