<style>
  /* ========== ROOT VARIABLES ========== */
  :root {
    --font-primary: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --blue: #2463af;
    --blue-dark: #1a4f8c;
    --blue-light: #e8f1fb;
    --yellow: #ffd600;
    --black: #000000;
    --dark: #1a1a1a;
    --text: #333333;
    --text-muted: #666666;
    --gray: #f3f3f3;
    --white: #ffffff;
  }

  /* ========== TESTIMONIALS SECTION ========== */
  .testimonials-section {
    padding: 40px 16px;
    background: var(--white);
  }

  .testimonials-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Header Styles */
  .testimonials-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .testimonials-badge {
    display: inline-block;
    background: var(--blue-light);
    color: var(--blue);
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-bottom: 12px;
    font-family: var(--font-primary);
  }

  .testimonials-title {
    font-size: 24px;
    font-weight: 700;
    color: var(--dark);
    margin: 12px 0;
    line-height: 1.2;
    font-family: var(--font-primary);
  }

  .testimonials-subtitle {
    font-size: 14px;
    color: var(--text-muted);
    margin: 8px 0 0;
    font-family: var(--font-primary);
  }

  /* Grid Layout */
  .testimonials-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  /* Card Styles */
  .testimonial-card {
    background: var(--white);
    border: 1px solid #e0e0e0;
    border-radius: 12px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }

  .testimonial-card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    transform: translateY(-2px);
  }

  .quote-icon {
    width: 32px;
    height: 32px;
    color: var(--blue);
    margin-bottom: 12px;
    opacity: 0.6;
  }

  .quote-icon svg {
    width: 100%;
    height: 100%;
  }

  .testimonial-quote {
    font-size: 16px;
    font-weight: 400;
    color: var(--text);
    line-height: 1.6;
    margin: 0 0 16px;
    font-family: var(--font-primary);
  }

  /* Customer Info */
  .testimonial-info {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .customer-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
  }

  .customer-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .customer-avatar-placeholder {
    background: var(--blue);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    font-weight: 700;
    font-family: var(--font-primary);
  }

  .customer-details {
    flex: 1;
  }

  .customer-name {
    font-size: 14px;
    font-weight: 700;
    color: var(--dark);
    margin: 0;
    font-family: var(--font-primary);
  }

  .customer-context {
    font-size: 12px;
    color: var(--text-muted);
    margin: 2px 0 0;
    font-family: var(--font-primary);
  }

  /* Rating Stars */
  .testimonial-rating {
    display: flex;
    gap: 4px;
  }

  .star {
    width: 16px;
    height: 16px;
  }

  .star.filled {
    fill: #fbbf24;
    color: #fbbf24;
  }

  .star.empty {
    fill: none;
    stroke: #e5e7eb;
    stroke-width: 2;
  }

  /* ========== TABLET LAYOUT ========== */
  @media (min-width: 768px) {
    .testimonials-section {
      padding: 60px 40px;
    }

    .testimonials-header {
      margin-bottom: 40px;
    }

    .testimonials-title {
      font-size: 32px;
    }

    .testimonials-subtitle {
      font-size: 16px;
    }

    .testimonials-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 28px;
    }

    .testimonial-card {
      padding: 28px;
    }

    .testimonial-quote {
      font-size: 15px;
    }
  }

  /* ========== DESKTOP LAYOUT ========== */
  @media (min-width: 1024px) {
    .testimonials-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }

    .testimonial-card {
      padding: 32px;
    }

    .testimonials-title {
      font-size: 36px;
    }
  }
</style>


<section class="testimonials-section">
  <div class="testimonials-container">
    <!-- Header -->
    <div class="testimonials-header">
      <span class="testimonials-badge">Testimonials</span>
      <h2 class="testimonials-title">{{ section.settings.heading | default: 'What Customers Have to Say' }}</h2>
      {% if section.settings.subtitle %}
        <p class="testimonials-subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <!-- Testimonials Grid/Carousel -->
    <div class="testimonials-grid">
      {% for block in section.blocks %}
        {% if block.type == 'testimonial' %}
          <div class="testimonial-card">
            <!-- Quote Icon -->
            <div class="quote-icon">
              <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 21c3 0 7-1 7-8V5c0-1.25-4.716-5-7-5C4.72 0 .69 2.5.69 5.5 0 13.5 3 21 3 21z" />
                <path d="M15 21c3 0 7-1 7-8V5c0-1.25-4.716-5-7-5C16.72 0 12.69 2.5 12.69 5.5 12 13.5 15 21 15 21z" />
              </svg>
            </div>

            <!-- Testimonial Quote -->
            <p class="testimonial-quote">{{ block.settings.quote }}</p>

            <!-- Customer Info -->
            <div class="testimonial-info">
              {% if block.settings.image %}
                <div class="customer-avatar">
                  {{ block.settings.image | img_url: '80x80' | img_tag: block.settings.name }}
                </div>
              {% else %}
                <div class="customer-avatar customer-avatar-placeholder">
                  {{ block.settings.name | slice: 0 }}
                </div>
              {% endif %}

              <div class="customer-details">
                <h4 class="customer-name">{{ block.settings.name }}</h4>
                {% if block.settings.context %}
                  <p class="customer-context">{{ block.settings.context }}</p>
                {% endif %}
              </div>
            </div>

            <!-- Rating Stars -->
            {% if block.settings.rating > 0 %}
              <div class="testimonial-rating">
                {% for i in (1..5) %}
                  {% if i <= block.settings.rating %}
                    <svg class="star filled" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  {% else %}
                    <svg class="star empty" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Customers Have to Say"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer Photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer Name",
          "default": "John Smith"
        },
        {
          "type": "text",
          "id": "context",
          "label": "Context (e.g., Vehicle Model)",
          "default": "Toyota RAV 4 Owner"
        },
        {
          "type": "text",
          "id": "quote",
          "label": "Testimonial Quote",
          "default": "These shades are amazing! They fit perfectly and the UV protection is exactly what I needed.",
          "info": "Enter the customer testimonial text"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star Rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "name": "Sarah Johnson",
            "context": "Toyota RAV 4 Owner",
            "quote": "Absolutely love these shades! They fit my RAV 4 perfectly and the UV protection has made such a difference. Installation was incredibly easy too.",
            "rating": 5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "name": "Mike Chen",
            "context": "Honda Civic Driver",
            "quote": "Best purchase I've made for my car. The shades look great, feel premium, and arrived faster than expected. Highly recommend!",
            "rating": 5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "name": "Emma Davis",
            "context": "Mazda CX-5 Owner",
            "quote": "The custom fit is incredible. No more generic shades that don't fit properly. My car stays cool and protected all summer long.",
            "rating": 5
          }
        }
      ]
    }
  ]
}
{% endschema %}
