          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Do the shades work with all car types?",
            "answer": "<p>We have shades available for most vehicles including sedans, SUVs, utes, and vans. Use our car selector to check if we have shades for your specific vehicle.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How do I clean the shades?",
            "answer": "<p>Simply wipe down with a soft, dry cloth or mild soap and water. Avoid harsh chemicals or abrasive materials that could damage the mesh. Allow to air dry completely before storing.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
