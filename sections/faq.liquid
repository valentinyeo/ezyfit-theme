{%- liquid
  assign ezy_skip = false
  if template.name == 'product'
    if product.title contains 'Wiper'
      assign ezy_skip = true
    endif
  endif
-%}
{%- unless ezy_skip -%}
<style>
  /* ========== FAQ SECTION ========== */
  .faq-section {
    padding: 48px 16px;
    background: var(--white, #ffffff);
  }

  .faq-container {
    max-width: 1168px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .faq-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .faq-title {
    font-size: 28px;
    font-weight: 700;
    color: var(--dark, #1a1a1a);
    margin: 0 0 12px;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .faq-subtitle {
    font-size: 16px;
    font-weight: 400;
    color: var(--text-muted, #333333);
    margin: 0;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .faq-items {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq-item {
    border: 1px solid var(--border-color, #e0e0e0);
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .faq-item:hover {
    border-color: var(--blue, #2463af);
    box-shadow: 0 2px 8px rgba(36, 99, 175, 0.1);
  }

  .faq-trigger {
    width: 100%;
    padding: 20px 16px;
    background: var(--white, #ffffff);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    transition: background-color 0.2s ease;
  }

  .faq-trigger:hover {
    background-color: var(--gray, #f9f9f9);
  }

  .faq-trigger[aria-expanded="true"] {
    background-color: var(--blue-light, #e8f1fb);
  }

  .faq-question {
    font-size: 15px;
    font-weight: 600;
    color: var(--dark, #1a1a1a);
    text-align: left;
    flex: 1;
  }

  .faq-icon {
    width: 24px;
    height: 24px;
    min-width: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    color: var(--blue, #2463af);
  }

  .faq-trigger[aria-expanded="true"] .faq-icon {
    transform: rotate(180deg);
  }

  .faq-icon svg {
    width: 20px;
    height: 20px;
    stroke: currentColor;
  }

  .faq-content {
    border-top: 1px solid var(--border-color, #e0e0e0);
    animation: slideDown 0.3s ease forwards;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      max-height: 0;
    }
    to {
      opacity: 1;
      max-height: 500px;
    }
  }

  .faq-answer {
    padding: 16px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-muted, #333333);
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: var(--white, #ffffff);
  }

  /* Desktop Layout */
  @media (min-width: 768px) {
    .faq-section {
      padding: 60px 40px;
    }

    .faq-header {
      margin-bottom: 48px;
    }

    .faq-title {
      font-size: 36px;
      margin-bottom: 12px;
    }

    .faq-subtitle {
      font-size: 18px;
    }

    .faq-item {
      border-radius: 10px;
    }

    .faq-trigger {
      padding: 24px 24px;
    }

    .faq-question {
      font-size: 16px;
    }

    .faq-answer {
      padding: 20px 24px;
      font-size: 15px;
    }
  }
</style>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
      {
        "@type": "Question",
        "name": {{ block.settings.question | json }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ block.settings.answer | strip_html | json }}
        }
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>

<section class="faq-section">
  <div class="faq-container">
    <div class="faq-header">
      <h2 class="faq-title">{{ section.settings.heading | default: 'Frequently Asked Questions' }}</h2>
      <p class="faq-subtitle">{{ section.settings.subtitle | default: "Looking for answers? You've come to the right place." }}</p>
    </div>

    <div class="faq-items">
      {% for block in section.blocks %}
        <div class="faq-item" data-faq-item>
          <button class="faq-trigger" aria-expanded="false">
            <span class="faq-question">{{ block.settings.question }}</span>
            <span class="faq-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </span>
          </button>
          <div class="faq-content" style="display: none;">
            <div class="faq-answer">
              {{ block.settings.answer }}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const faqItems = document.querySelectorAll('[data-faq-item]');

    faqItems.forEach(item => {
      const trigger = item.querySelector('.faq-trigger');
      const content = item.querySelector('.faq-content');

      trigger.addEventListener('click', function() {
        const isExpanded = trigger.getAttribute('aria-expanded') === 'true';

        // Close all other items
        faqItems.forEach(otherItem => {
          if (otherItem !== item) {
            const otherTrigger = otherItem.querySelector('.faq-trigger');
            const otherContent = otherItem.querySelector('.faq-content');
            otherTrigger.setAttribute('aria-expanded', 'false');
            otherContent.style.display = 'none';
          }
        });

        // Toggle current item
        trigger.setAttribute('aria-expanded', !isExpanded);
        content.style.display = isExpanded ? 'none' : 'block';
      });
    });
  });
</script>
{%- endunless -%}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Looking for answers? You've come to the right place."
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How do I know what size shades I need?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Enter your vehicle's year, make, and model in our car selector and we'll recommend the perfect fit for your specific vehicle.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "How do I know what size shades I need?",
            "answer": "<p>Enter your vehicle's year, make, and model in our car selector and we'll recommend the perfect fit for your specific vehicle.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Are the shades easy to install?",
            "answer": "<p>Yes! Our shades are designed for hassle-free installation. Simply unfold and place inside your car windows - no tools or adhesives needed. Most customers install them in under 2 minutes.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What level of UV protection do your shades provide?",
            "answer": "<p>Our advanced mesh technology blocks 87% of harmful UV rays, protecting your car's interior from fading and damage while keeping it cooler on hot days.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
