{%- liquid
  assign finder_collection = collections[section.settings.collection]
-%}
<section class="ezy ezy-hero" id="find">
  <div class="ezy-wrap ezy-hero__grid">
    <div>
      <h1>{{ section.settings.heading }}</h1>
      <p class="ezy-hero__lead">{{ section.settings.lead }}</p>
      {%- if section.settings.rating_text != blank -%}
        <a class="ezy-hero__rating" href="#ezy-reviews"><b aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</b> {{ section.settings.rating_text }}</a>
      {%- endif -%}

      <form class="ezy-finder" action="{{ routes.search_url }}" method="get" data-ezy-finder>
        {%- comment -%}
          MACL-37 P96: live's finder serves shade shoppers, this one served wipers only.
          The pills switch the catalogue; Wipers stays the default so the blade flow is
          exactly what it was. Sun shades reads the live brand collections.
        {%- endcomment -%}
        <fieldset class="ezy-finder__modes">
          <legend class="visually-hidden">What are you shopping for?</legend>
          <label class="ezy-finder__mode">
            <input type="radio" name="ezy-finder-type" value="wipers" checked data-ezy-finder-type>
            <span>Wipers</span>
          </label>
          <label class="ezy-finder__mode">
            <input type="radio" name="ezy-finder-type" value="shades" data-ezy-finder-type>
            <span>Sun shades</span>
          </label>
        </fieldset>
        <input type="hidden" name="type" value="product">
        <input type="hidden" name="q" data-ezy-q>
        <div class="ezy-dd" data-ezy-dd="make">
          <button type="button" class="ezy-dd__btn" aria-haspopup="listbox" aria-expanded="false">
            <span class="ezy-dd__val" data-placeholder="Select Make">Select Make</span>
          </button>
          <div class="ezy-dd__menu" hidden>
            <input type="text" class="ezy-dd__search" placeholder="Search make..." aria-label="Search make" autocomplete="off">
            <ul class="ezy-dd__list" role="listbox" aria-label="Make"></ul>
          </div>
        </div>
        <div class="ezy-dd" data-ezy-dd="model">
          <button type="button" class="ezy-dd__btn" aria-haspopup="listbox" aria-expanded="false" disabled>
            <span class="ezy-dd__val" data-placeholder="Select Model">Select Model</span>
          </button>
          <div class="ezy-dd__menu" hidden>
            <input type="text" class="ezy-dd__search" placeholder="Search model..." aria-label="Search model" autocomplete="off">
            <ul class="ezy-dd__list" role="listbox" aria-label="Model"></ul>
          </div>
        </div>
        <div class="ezy-dd" data-ezy-dd="year">
          <button type="button" class="ezy-dd__btn" aria-haspopup="listbox" aria-expanded="false" disabled>
            <span class="ezy-dd__val" data-placeholder="Select Year">Select Year</span>
          </button>
          <div class="ezy-dd__menu" hidden>
            <input type="text" class="ezy-dd__search" placeholder="Search year..." aria-label="Search year" autocomplete="off">
            <ul class="ezy-dd__list" role="listbox" aria-label="Year"></ul>
          </div>
        </div>
        <button class="ezy-btn" type="submit" data-find-wipers="{{ section.settings.button }}" data-find-shades="{{ section.settings.button_shade }}">{{ section.settings.button }}</button>
        <p class="ezy-finder__next" data-next-wipers="{{ section.settings.next_text }}" data-next-shades="{{ section.settings.next_text_shade }}">{{ section.settings.next_text }}</p>
      </form>
    </div>

    <div>
      <a class="ezy-video" href="{{ section.settings.video_url | default: '#' }}">
        {%- if section.settings.video_image != blank -%}
          {{ section.settings.video_image | image_url: width: 900 | image_tag: loading: 'lazy' }}
        {%- else -%}
          <img src="{{ section.settings.video_asset | default: 'ezy-hero-video.png' | asset_url }}" alt="{{ section.settings.video_label | escape }}" loading="lazy">
        {%- endif -%}
        <span class="ezy-video__play" aria-hidden="true"></span>
        <span class="ezy-video__label">{{ section.settings.video_label }}</span>
      </a>

      <div class="ezy-pack">
        <h2 class="ezy-hero__h">{{ section.settings.pack_heading }}</h2>
        <ul class="ezy-ticks">
          {%- for block in section.blocks -%}
            {%- if block.type == 'pack_item' -%}<li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
        <p class="ezy-pack__price">{{ section.settings.pack_price }}</p>
      </div>

      <div class="ezy-hero__ticks">
        {%- for block in section.blocks -%}
          {%- if block.type == 'tick' -%}<span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>{%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{%- if section.settings.sticky -%}
  <div class="ezy ezy-sticky" data-ezy-sticky>
    <div><b>{{ section.settings.sticky_title }}</b><small>{{ section.settings.sticky_sub }}</small></div>
    <a class="ezy-btn" href="#find">{{ section.settings.button }}</a>
  </div>
{%- endif -%}

<script type="application/json" data-ezy-products>
  [
  {%- if finder_collection != blank -%}
    {%- comment -%} collection.products returns 50 without paginate, even with limit: 250. Paginate by 250 so every wiper is listed. {%- endcomment -%}
    {%- paginate finder_collection.products by 250 -%}
      {%- for product in finder_collection.products -%}
        {"t": {{ product.title | json }}, "u": {{ product.url | json }}}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    {%- endpaginate -%}
  {%- endif -%}
  ]
</script>
<script>
  (function () {
    var form = document.querySelector('[data-ezy-finder]');
    if (!form) return;
    var raw = JSON.parse(document.querySelector('[data-ezy-products]').textContent || '[]');
    // EZY-PARSE-START
    var TWO_WORD = ['Mercedes Benz', 'Land Rover', 'Alfa Romeo', 'Aston Martin', 'Great Wall', 'Rolls Royce'];
    var cars = [], rejected = [];
    raw.forEach(function (p) {
      var m = p.t.match(/\bfor\s+(.+)$/i);
      if (!m) { rejected.push(p.t); return; }
      var txt = document.createElement('textarea'); txt.innerHTML = m[1]; // decode &amp; and friends
      // Model name stops at the first year, so "Mondeo Sedan Hatch 2007 2014 MA MB" becomes "Mondeo Sedan Hatch".
      var rest = txt.value.replace(/\s*->\s*$/, '').split(/\s+(?:19|20)\d{2}\b/)[0].replace(/[\s\-\u2013]+$/, '').trim();
      var words = rest.split(/\s+/);
      var make = words[0];
      if (TWO_WORD.indexOf((words[0] + ' ' + (words[1] || '')).replace('-', ' ')) > -1) make = words[0] + ' ' + words[1];
      var model = rest.slice(make.length).trim();
      if (/^vw$/i.test(make)) make = 'Volkswagen';
      var yrs = (txt.value.match(/\b(?:19|20)\d{2}\b/g) || []).slice(0, 2);
      var year = yrs.length === 2 ? yrs[0] + ' to ' + yrs[1] : (yrs[0] || '');
      if (model) cars.push({ make: make, model: model, year: year, url: p.u }); else rejected.push(p.t);
    });
    // EZY-PARSE-END
    // Sun shades read the live brand collections, the same list live's car-selector uses.
    var SHADE_BRANDS = {
      'Toyota': 'sun-shade-for-car-wiper-bladess-for-toyota',
      'Ford': 'sun-shade-for-car-wiper-bladess-for-ford',
      'Mazda': 'sun-shade-for-car-wiper-bladess-for-mazda',
      'Honda': 'car-windscreen-shade-windscreen-wiper-blades-for-honda',
      'Hyundai': 'sun-shade-for-car-wiper-bladess-for-hyundai',
      'Nissan': 'sun-shade-for-car-wiper-bladess-for-nissan',
      'Mitsubishi': 'sun-shade-for-car-wiper-bladess-for-mitsubishi',
      'Kia': 'sun-shade-for-car-wiper-bladess-for-kia',
      'BMW': 'car-window-sun-shades-wiper-blade-for-bmw',
      'Mercedes-Benz': 'sun-shade-for-car-wiper-bladess-for-mercedes',
      'Volkswagen': 'sun-shade-for-car-wiper-bladess-for-volkswagen',
      'Subaru': 'sun-shade-for-car-good-wiper-blades-for-subaru',
      'Isuzu': 'car-windscreen-shade-windscreen-wiper-blades-for-isuzu',
      'Lexus': 'sun-shade-for-car-wiper-bladess-for-lexus',
      'MG': 'sunshades-for-car-windows-wiper-blade-for-mg',
      'Chevrolet': 'sun-shade-for-car-wiper-bladess-for-chevrolet',
      'Geely': 'sun-shade-for-car-wiper-bladess-for-geely',
      'Infiniti': 'sun-shade-for-car-wiper-bladess-for-infiniti',
      'BYD': 'sun-shade-for-car-wiper-bladess-for-byd',
      'Chery': 'sun-shade-for-car-wiper-bladess-for-chery'
    };
    var wiperCars = cars;
    var shadeCars = [];
    var shadeCache = {};
    var mode = 'wipers';
    function catalog() { return mode === 'shades' ? shadeCars : wiperCars; }
    // "Rear Side Windows Click Shades for Toyota RAV 4 2019-2025" -> model "RAV 4", year "2019 to 2025".
    function shadeCar(p, brand) {
      var m = String(p.title || '').match(/\bfor\s+(.+)$/i);
      if (!m) return null;
      var rest = m[1].replace(/\s*->\s*$/, '').trim();
      var brandWords = brand.toLowerCase().replace(/[^a-z0-9 ]/g, ' ').split(/\s+/).filter(Boolean);
      var words = rest.split(/\s+/);
      while (words.length > 1 && brandWords.indexOf(words[0].toLowerCase().replace(/[^a-z0-9]/g, '')) > -1) words.shift();
      rest = words.join(' ');
      var year = '';
      var yrs = rest.match(/\b(?:19|20)\d{2}\b(?:\s*[-\u2013]\s*\b(?:19|20)\d{2}\b)?\s*$/);
      if (yrs) {
        var nums = yrs[0].match(/\d{4}/g);
        year = nums.length > 1 ? nums[0] + ' to ' + nums[1] : nums[0];
        rest = rest.slice(0, yrs.index).trim();
      }
      if (!rest) return null;
      return { make: brand, model: rest, year: year, url: p.url };
    }
    // "rav4", "RAV 4" and "Rav-4" all compare equal.
    var norm = function (s) { return s.toLowerCase().replace(/[^a-z0-9]/g, ''); };
    var q = form.querySelector('[data-ezy-q]');
    var uniq = function (xs) { return Array.from(new Set(xs)); };
    var pick = { make: '', model: '', year: '' };
    var dds = {};
    function closeAll(except) {
      Object.keys(dds).forEach(function (k) { if (dds[k] !== except) dds[k].close(); });
    }
    function Dropdown(el, onPick) {
      var btn = el.querySelector('.ezy-dd__btn'), val = el.querySelector('.ezy-dd__val');
      var menu = el.querySelector('.ezy-dd__menu'), search = el.querySelector('.ezy-dd__search');
      var list = el.querySelector('.ezy-dd__list');
      var items = [];
      var self = {
        set: function (opts) {
          items = opts; list.innerHTML = '';
          opts.forEach(function (o) {
            var li = document.createElement('li');
            li.setAttribute('role', 'option'); li.tabIndex = -1; li.textContent = o;
            li.addEventListener('click', function () { self.choose(o); });
            li.addEventListener('keydown', function (e) {
              if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); self.choose(o); }
              var visible = Array.from(list.children).filter(function (option) { return !option.hidden; });
              var index = visible.indexOf(li);
              if (e.key === 'ArrowDown') { e.preventDefault(); (visible[index + 1] || li).focus(); }
              if (e.key === 'ArrowUp') { e.preventDefault(); (visible[index - 1] || (search.hidden ? btn : search)).focus(); }
            });
            list.appendChild(li);
          });
          btn.disabled = !opts.length;
          self.reset();
          if (opts.length === 1) self.choose(opts[0]);
        },
        reset: function () { val.textContent = val.dataset.placeholder; el.classList.remove('is-set'); },
        choose: function (o) {
          val.textContent = o; el.classList.add('is-set'); self.close(); btn.focus(); onPick(o);
        },
        open: function () {
          closeAll(self); menu.hidden = false; el.classList.add('is-open'); btn.setAttribute('aria-expanded', 'true');
          search.value = ''; self.filter('');
          (search.hidden ? (list.firstElementChild || btn) : search).focus();
        },
        close: function () { menu.hidden = true; el.classList.remove('is-open'); btn.setAttribute('aria-expanded', 'false'); },
        filter: function (t) {
          var n = norm(t);
          Array.from(list.children).forEach(function (li) { li.hidden = n && norm(li.textContent).indexOf(n) < 0; });
        }
      };
      // Few options need no search box.
      self.searchable = function (on) { search.hidden = !on; };
      btn.addEventListener('click', function () { menu.hidden ? self.open() : self.close(); });
      btn.addEventListener('keydown', function (e) {
        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
        e.preventDefault();
        if (menu.hidden) self.open();
        var visible = Array.from(list.children).filter(function (li) { return !li.hidden; });
        var option = e.key === 'ArrowUp' ? visible[visible.length - 1] : visible[0];
        if (option) option.focus();
      });
      search.addEventListener('input', function () { self.filter(search.value); });
      search.addEventListener('keydown', function (e) {
        var first = Array.from(list.children).find(function (li) { return !li.hidden; });
        if (e.key === 'ArrowDown' && first) { e.preventDefault(); first.focus(); }
        if (e.key === 'Enter') { e.preventDefault(); if (first) self.choose(first.textContent); }
      });
      el.addEventListener('keydown', function (e) { if (e.key === 'Escape') { self.close(); btn.focus(); } });
      return self;
    }
    var yearOf = function (c) { return c.year; };
    dds.make = Dropdown(form.querySelector('[data-ezy-dd=make]'), function (mk) {
      pick.make = mk; pick.model = ''; pick.year = '';
      dds.year.set([]);
      if (mode === 'shades') { loadShadeMake(mk); return; }
      dds.model.set(uniq(wiperCars.filter(function (c) { return c.make === mk; }).map(function (c) { return c.model; })).sort());
    });
    dds.model = Dropdown(form.querySelector('[data-ezy-dd=model]'), function (md) {
      pick.model = md; pick.year = '';
      var years = uniq(catalog().filter(function (c) { return c.make === pick.make && c.model === md; }).map(yearOf).filter(Boolean)).sort();
      dds.year.set(years);
    });
    dds.year = Dropdown(form.querySelector('[data-ezy-dd=year]'), function (y) { pick.year = y; });
    // Models for a shade brand come from that brand's collection, the way live's car-selector loads them.
    function loadShadeMake(mk) {
      var cached = shadeCache[mk];
      if (cached) {
        shadeCars = cached;
        dds.model.set(uniq(cached.map(function (c) { return c.model; })).sort());
        return;
      }
      shadeCars = [];
      var handle = SHADE_BRANDS[mk];
      if (!handle) return;
      fetch('/collections/' + handle + '/products.json?limit=250')
        .then(function (r) { return r.ok ? r.json() : { products: [] }; })
        .then(function (data) {
          var parsed = (data.products || []).map(function (p) { return shadeCar(p, mk); }).filter(Boolean);
          shadeCache[mk] = parsed;
          if (mode !== 'shades' || pick.make !== mk) return;
          shadeCars = parsed;
          dds.model.set(uniq(parsed.map(function (c) { return c.model; })).sort());
        })
        .catch(function () { if (mode === 'shades' && pick.make === mk) dds.model.set([]); });
    }
    function setMode(m) {
      mode = m;
      pick.make = ''; pick.model = ''; pick.year = '';
      dds.year.set([]);
      dds.model.set([]);
      var submitBtn = form.querySelector('button[type=submit]');
      var nextEl = form.querySelector('.ezy-finder__next');
      if (submitBtn) submitBtn.textContent = m === 'shades' ? submitBtn.dataset.findShades : submitBtn.dataset.findWipers;
      if (nextEl) nextEl.textContent = m === 'shades' ? nextEl.dataset.nextShades : nextEl.dataset.nextWipers;
      if (m === 'shades') {
        shadeCars = [];
        dds.make.set(Object.keys(SHADE_BRANDS).sort());
      } else {
        dds.make.set(uniq(wiperCars.map(function (c) { return c.make; })).sort());
      }
    }
    form.querySelectorAll('[data-ezy-finder-type]').forEach(function (input) {
      input.addEventListener('change', function () { if (input.checked) setMode(input.value); });
    });
    setMode('wipers');
    dds.model.searchable(false); dds.year.searchable(false);
    dds.model.set([]); dds.year.set([]);
    document.addEventListener('click', function (e) { if (!form.contains(e.target)) closeAll(null); });
    form.addEventListener('submit', function (e) {
      if (!pick.make) { e.preventDefault(); dds.make.open(); return; }
      if (mode === 'shades') {
        // Same route as live's car-selector: one match opens the product, several go to search.
        var shadeHits = shadeCars.filter(function (c) {
          return c.make === pick.make && (!pick.model || c.model === pick.model) && (!pick.year || c.year === pick.year);
        });
        if (shadeHits.length === 1) { e.preventDefault(); window.location.href = shadeHits[0].url; return; }
        q.value = (pick.make + ' ' + pick.model).trim();
        return;
      }
      var hits = wiperCars.filter(function (c) {
        return c.make === pick.make && (!pick.model || c.model === pick.model) && (!pick.year || c.year === pick.year);
      });
      if (hits.length === 1) { e.preventDefault(); window.location.href = hits[0].url; return; }
      // Several or no matches: store search limited to wipers.
      q.value = 'wipers ' + (pick.make + ' ' + pick.model).trim();
    });
    var sticky = document.querySelector('[data-ezy-sticky]');
    if (sticky && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        var e = entries[0];
        sticky.classList.toggle('is-shown', !e.isIntersecting && e.boundingClientRect.top < 0);
      }).observe(form);
    }
  })();
</script>

{% schema %}
{
  "name": "EZY hero and finder",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wiper blades made for your exact car" },
    { "type": "textarea", "id": "lead", "label": "Lead", "default": "Guaranteed fit for your specific vehicle. Front pair from $59, was $79, 25% off is already in the price. Search your car, then watch its own 2 minute fitment video." },
    { "type": "text", "id": "rating_text", "label": "Store rating text (fill from Loox)", "default": "4.8 from 49 store reviews" },
    { "type": "collection", "id": "collection", "label": "Wiper collection for the finder" },
    { "type": "text", "id": "finder_heading", "label": "Finder heading (unused, the pills label the finder)", "default": "Find your wipers" },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Your car, for example Ranger" },
    { "type": "text", "id": "button", "label": "Wipers button", "default": "Find my wipers" },
    { "type": "text", "id": "next_text", "label": "Text under the wipers button", "default": "Your car's blades and fitment video come next." },
    { "type": "text", "id": "button_shade", "label": "Sun shades button", "default": "Find my shades" },
    { "type": "text", "id": "next_text_shade", "label": "Text under the sun shades button", "default": "Your car's shades come next. Free shipping Australia wide." },
    { "type": "text", "id": "pack_heading", "label": "Pack heading", "default": "Your Exact Fit Pack" },
    { "type": "text", "id": "pack_price", "label": "Pack price line", "default": "From $59 a front pair. 25% off already in." },
    { "type": "image_picker", "id": "video_image", "label": "Video image" },
    { "type": "url", "id": "video_url", "label": "Video link" },
    { "type": "text", "id": "video_asset", "label": "Video image file (theme assets), used when no image is picked" },
    { "type": "text", "id": "video_label", "label": "Video label", "default": "Ford Ranger fitment, 1:52" },
    { "type": "checkbox", "id": "sticky", "label": "Sticky find bar on phones", "default": true },
    { "type": "text", "id": "sticky_title", "label": "Sticky bar title", "default": "From $59 a front pair" },
    { "type": "text", "id": "sticky_sub", "label": "Sticky bar subtext", "default": "Exact fit or 30-day returns" }
  ],
  "blocks": [
    { "type": "pack_item", "name": "Pack item", "settings": [{ "type": "text", "id": "text", "label": "Text" }] },
    { "type": "tick", "name": "Tick under video", "settings": [{ "type": "text", "id": "text", "label": "Text" }] }
  ]
}
{% endschema %}
