{{ 'ezy.css' | asset_url | stylesheet_tag }}
<section class="ezy ezy-sec ezy-sec--tint ezy-lead" id="ezy-lead">
  <div class="ezy-wrap">
    <h2 class="ezy-h2">{{ section.settings.heading }}</h2>
    <p class="ezy-sub">{{ section.settings.sub }}</p>
    {%- form 'customer', id: 'ezy-lead-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p><b>{{ section.settings.success }}</b></p>
      {%- else -%}
        <div>
          <label for="ezy-lead-email">Email</label>
          <input id="ezy-lead-email" type="email" name="contact[email]" placeholder="you@email.com" required autocomplete="email">
        </div>
        <button class="ezy-btn" type="submit">{{ section.settings.button }}</button>
      {%- endif -%}
    {%- endform -%}
    <p class="ezy-lead__fine">{{ section.settings.fine }}</p>
  </div>
</section>

{% schema %}
{
  "name": "EZY email signup",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not buying today?" },
    { "type": "text", "id": "sub", "label": "Subheading", "default": "Get fitting tips and our best offers by email. Free, unsubscribe any time." },
    { "type": "text", "id": "button", "label": "Button", "default": "Sign me up" },
    { "type": "text", "id": "fine", "label": "Small print", "default": "No spam. One click to unsubscribe." },
    { "type": "text", "id": "success", "label": "Thank you text", "default": "Thanks. You are on the list." }
  ]
}
{% endschema %}
