{{ 'ezy.css' | asset_url | stylesheet_tag }}
<section class="ezy ezy-sec ezy-sec--yellow ezy-sec--rule">
  <div class="ezy-wrap">
    <h2 class="ezy-h2" style="margin-bottom: 20px !important">{{ section.settings.heading }}</h2>
    <ol class="ezy-steps">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}><i>{{ forloop.index }}</i><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "EZY how to fit",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "How to fit them" }],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [{ "type": "text", "id": "title", "label": "Title" }, { "type": "text", "id": "text", "label": "Text" }] }
  ]
}
{% endschema %}
